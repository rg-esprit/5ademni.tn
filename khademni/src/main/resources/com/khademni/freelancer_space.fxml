<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.FreelancerSpaceController"
    fitToWidth="true" fitToHeight="true" styleClass="root-scroll"
    stylesheets="@contrat.css"
    style="-fx-background-color: #f7f5f8; -fx-background: #f7f5f8;">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="root">
        
        <!-- Global Header -->
        <fx:include source="header.fxml" />

        <!-- Main Content Area -->
        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 40 24 60 24;">

            <!-- Motivational Quote Header -->
            <VBox fx:id="quoteContainer" alignment="CENTER" spacing="12" maxWidth="1000" prefWidth="1000"
                style="-fx-padding: 28 36; -fx-background-color: linear-gradient(to right, rgba(108,13,242,0.08), rgba(108,92,231,0.12)); -fx-background-radius: 16; -fx-border-color: rgba(108,13,242,0.15); -fx-border-radius: 16; -fx-border-width: 1;">
                <Label fx:id="quoteLabel" text="Chargement..." wrapText="true"
                    style="-fx-font-size: 15px; -fx-font-style: italic; -fx-text-fill: #4a3f6b; -fx-text-alignment: center;"
                    alignment="CENTER" maxWidth="900" />
                <Label fx:id="quoteAuthor" text=""
                    style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6c0df2;" />
                <Button fx:id="refreshQuoteBtn" text="✨ Nouvelle inspiration" onAction="#refreshQuote"
                    style="-fx-background-color: transparent; -fx-text-fill: #6c5ce7; -fx-font-size: 12px; -fx-cursor: hand; -fx-border-color: #6c5ce7; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 18;" />
            </VBox>

            <!-- Main Card Container -->
            <VBox styleClass="card" spacing="28" maxWidth="1000" prefWidth="1000"
                style="-fx-padding: 36;">

                <!-- Header Section with Actions -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Espace Freelancer" styleClass="heading" />
                        <Label text="Gérez vos offres de service et exportez vos contrats en PDF" styleClass="subtitle-text" />
                    </VBox>
                    
                    <!-- Search Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-container" prefWidth="300">
                        <Label text="&#xe8b6;" styleClass="search-icon" />
                        <TextField fx:id="searchField" promptText="Rechercher par Titre ou ID..." 
                                   styleClass="search-field" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <Button text="Nouvel Offre" styleClass="button-primary"
                        onAction="#goToAddOffer">
                        <graphic>
                            <Label text="&#xe145;" styleClass="btn-icon-arrow" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Table View -->
                <TableView fx:id="offreTable" VBox.vgrow="ALWAYS" minHeight="450">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colUserId" text="ID Freelancer" prefWidth="100" />
                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="250" />
                        <TableColumn fx:id="colPrix" text="Prix (DT)" prefWidth="100" />
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" />
                        <TableColumn fx:id="colDate" text="Date Création" prefWidth="120" />
                        <TableColumn fx:id="colDateLimite" text="Date limite CDD" prefWidth="120" />
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="250" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </VBox>

        </VBox>
    </VBox>
</ScrollPane>
