<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.khademni.controller.JobApplicationController"
    style="-fx-background-color: #f7f5f8;">
    <style>
        .root {
            -fx-font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial;
            -fx-font-size: 12px;
        }
        
        .header-label {
            -fx-font-size: 24px;
            -fx-font-weight: bold;
            -fx-text-fill: #141118;
        }
        
        .job-label {
            -fx-font-size: 14px;
            -fx-font-weight: 600;
            -fx-text-fill: #6c0df2;
        }
        
        .button {
            -fx-padding: 10 18 10 18;
            -fx-font-size: 12px;
            -fx-font-weight: 600;
            -fx-border-radius: 8;
            -fx-background-radius: 8;
            -fx-cursor: hand;
            -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.06), 12, 0.2, 0, 2);
        }
        
        .button:hover {
            -fx-scale-x: 1.05;
            -fx-scale-y: 1.05;
            -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.12), 20, 0.3, 0, 4);
        }
        
        .add-btn {
            -fx-background-color: #6c0df2;
            -fx-text-fill: white;
        }
        
        .add-btn:hover {
            -fx-background-color: #5a0ad9;
        }
        
        .edit-btn {
            -fx-background-color: #8b5cf6;
            -fx-text-fill: white;
        }
        
        .edit-btn:hover {
            -fx-background-color: #7c3aed;
        }
        
        .delete-btn {
            -fx-background-color: #ef4444;
            -fx-text-fill: white;
        }
        
        .delete-btn:hover {
            -fx-background-color: #dc2626;
        }
        
        .combo-box {
            -fx-padding: 8 12 8 12;
            -fx-font-size: 12px;
            -fx-background-color: #fafafa;
            -fx-border-color: #e5e7eb;
            -fx-border-radius: 8;
            -fx-border-width: 1.5;
        }
        
        .combo-box:focused {
            -fx-border-color: #6c0df2;
            -fx-background-color: white;
        }
        
        .table-view {
            -fx-padding: 0;
            -fx-background-color: white;
        }
        
        .table-view .table-row-cell {
            -fx-border-color: #f0f0f0;
            -fx-border-width: 0 0 1 0;
            -fx-padding: 8 0 8 0;
        }
        
        .table-view .table-row-cell:hover {
            -fx-background-color: #f9f9f9;
        }
        
        .table-view .table-row-cell:selected {
            -fx-background-color: #f3e8ff;
        }
        
        .table-view .column-header {
            -fx-background-color: #f9fafb;
            -fx-border-color: #e5e7eb;
            -fx-border-width: 0 0 2 0;
            -fx-font-weight: 600;
            -fx-font-size: 12px;
            -fx-text-fill: #374151;
            -fx-padding: 12 8 12 8;
        }
    </style>

    <!-- Top Header -->
    <top>
        <VBox spacing="15" style="-fx-padding: 20 24 20 24; -fx-background-color: white; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
            <VBox spacing="8">
                <Label text="📋 Job Applications" styleClass="header-label" />
                <Label fx:id="jobTitleLabel" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #374151;" />
            </VBox>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="applicationsCountLabel" style="-fx-text-fill: #6b7280; -fx-font-size: 12; -fx-font-weight: 600;" />
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Filter by Status:" style="-fx-font-size: 12; -fx-font-weight: 600;"/>
                    <ComboBox fx:id="statusFilterCombo" prefWidth="150" styleClass="combo-box" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- Center - Table View -->
    <center>
        <TableView fx:id="applicationsTable" style="-fx-font-size: 11px; -fx-padding: 0; -fx-background-color: white;" styleClass="table-view">
            <columns>
                <TableColumn fx:id="nameColumn" text="👤 Applicant Name" prefWidth="130" />
                <TableColumn fx:id="emailColumn" text="📧 Email" prefWidth="150" />
                <TableColumn fx:id="titleColumn" text="📝 Application Title" prefWidth="180" />
                <TableColumn fx:id="descriptionColumn" text="💬 Description" prefWidth="200" />
                <TableColumn fx:id="cvColumn" text="📄 CV URL" prefWidth="150" />
                <TableColumn fx:id="statusColumn" text="✓ Status" prefWidth="90" />
                <TableColumn fx:id="appliedDateColumn" text="📅 Applied Date" prefWidth="110" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Bottom - Buttons -->
    <bottom>
        <HBox spacing="12" style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: #f0f0f0; -fx-border-width: 1 0 0 0;" alignment="CENTER_LEFT">
            <Button fx:id="addButton" text="➕ Add Application" styleClass="add-btn" />
            <Button fx:id="editButton" text="✏️ Edit Application" styleClass="edit-btn" />
            <Button fx:id="deleteButton" text="🗑️ Delete Application" styleClass="delete-btn" />
        </HBox>
    </bottom>
</BorderPane>
