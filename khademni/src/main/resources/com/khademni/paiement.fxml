<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.PaiementController"
    fitToWidth="true" fitToHeight="false" styleClass="bento-root"
    stylesheets="@contrat.css">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="bento-root">

        <!-- Global Header -->
        <fx:include source="header.fxml" />

        <VBox alignment="TOP_LEFT" spacing="0" style="-fx-padding: 40 40 100 40;">

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 30 0;">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="MES PAIEMENTS" styleClass="kinetic-label-small" />
                    <Label text="Contrats Payés" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #1a1a1a;" />
                </VBox>
                <HBox styleClass="floating-search" alignment="CENTER_LEFT" spacing="8">
                    <Label text="&#xe8b6;" style="-fx-font-family: 'Material Symbols Outlined'; -fx-font-size: 18; -fx-text-fill: #6b7280;" />
                    <TextField fx:id="searchField" promptText="Rechercher un paiement..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14;" />
                </HBox>
                <Button text="📄 Contrats" onAction="#goToContrats" styleClass="btn-nouveau" style="-fx-cursor: hand;" />
            </HBox>

            <!-- STATS ROW -->
            <HBox spacing="24" style="-fx-padding: 0 0 24 0;" alignment="CENTER_LEFT">
                <HBox styleClass="summary-card" spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <VBox styleClass="summary-icon-box summary-icon-green" alignment="CENTER">
                        <Label text="&#x2705;" style="-fx-font-size: 24;" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="TRANSACTIONS" styleClass="kinetic-label-small" style="-fx-text-fill: #0f9d66;" />
                        <Label fx:id="paymentCountLabel" text="0" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #17111f;" />
                    </VBox>
                </HBox>
                <HBox styleClass="summary-card" spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <VBox styleClass="summary-icon-box" alignment="CENTER">
                        <Label text="&#x1F3E6;" style="-fx-font-size: 24;" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="TOTAL PAYÉ" styleClass="kinetic-label-small" style="-fx-text-fill: #3b82f6;" />
                        <Label fx:id="totalPaidLabel" text="0 TND" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #17111f;" />
                    </VBox>
                </HBox>
            </HBox>

            <!-- RESULT COUNT -->
            <Label fx:id="countLabel" text="Chargement..." styleClass="result-count" style="-fx-padding: 0 0 16 0;" />

            <!-- PAYMENT LIST -->
            <VBox fx:id="paiementListContainer" spacing="16" />

            <!-- Footer -->
            <VBox alignment="CENTER" style="-fx-padding: 40 0 0 0;">
                <Label text="© 2026 5ademni.tn. All rights reserved." styleClass="footer-text" />
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
