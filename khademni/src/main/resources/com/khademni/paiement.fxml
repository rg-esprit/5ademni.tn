<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.PaiementController"
    fitToWidth="true" fitToHeight="true" styleClass="root-scroll"
    stylesheets="@contrat.css"
    style="-fx-background-color: #f7f5f8; -fx-background: #f7f5f8;">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="root">
        
        <!-- Global Header -->
        <fx:include source="header.fxml" />

        <!-- Main Content Area -->
        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 40 24 60 24;">

            <!-- Main Card Container -->
            <VBox styleClass="card" spacing="28" maxWidth="900" prefWidth="900"
                style="-fx-padding: 36;">

                <!-- Header Section -->
                <HBox alignment="CENTER" spacing="16">
                    <VBox spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Finaliser votre Paiement" styleClass="heading" />
                        <Label text="Utilisez Stripe pour régler vos contrats en toute sécurité" styleClass="subtitle-text" />
                    </VBox>
                </HBox>
                
                <!-- Contract Status Table -->
                <VBox spacing="15">
                    <Label text="Gestion des Statuts de Contrat" styleClass="heading" style="-fx-font-size: 18px;" />
                    <TableView fx:id="contratStatusTable" minHeight="250" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="colId" text="ID Contrat" prefWidth="100" />
                            <TableColumn fx:id="colFreelancer" text="Nom Freelancer" prefWidth="120" />
                            <TableColumn fx:id="colClient" text="Nom Client" prefWidth="120" />
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <!-- Floating Action Bar (Hidden by default) -->
                    <HBox fx:id="floatingActionBar" alignment="CENTER" spacing="16" visible="false" managed="false"
                          style="-fx-background-color: #ffffff; -fx-padding: 12 24; -fx-background-radius: 50; 
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4); 
                                 -fx-border-color: #e5e7eb; -fx-border-radius: 50; -fx-border-width: 1;">
                        <Button fx:id="fabPayeBtn" text="Payé" styleClass="button-primary" onAction="#onFabPaye" 
                                style="-fx-background-color: #6c5ce7; -fx-text-fill: white;" />
                        <Button fx:id="fabAttenteBtn" text="En Attente" styleClass="button-primary" onAction="#onFabAttente" 
                                style="-fx-background-color: #a29bfe; -fx-text-fill: white;" />
                        <Button fx:id="fabAnnulerBtn" text="Annuler" styleClass="button-secondary" onAction="#onFabAnnuler" 
                                style="-fx-background-color: white; -fx-text-fill: #6c5ce7; -fx-border-color: #6c5ce7;" />
                    </HBox>
                </VBox>

                <!-- Action Button -->
                <VBox alignment="CENTER" spacing="20">
                    <Label text="Cliquez ci-dessous pour générer votre lien de paiement" 
                           style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
                        <Button text="Payer avec Stripe" styleClass="button-primary" onAction="#handlePay"
                            style="-fx-padding: 12 40; -fx-font-size: 16px;">
                        <graphic>
                            <Label text="&#xefcc;" styleClass="btn-icon-arrow" />
                        </graphic>
                    </Button>
                </VBox>

            </VBox>

            <!-- Footer -->
            <VBox alignment="CENTER" style="-fx-padding: 24 0 0 0;">
                <Label text="© 2026 5ademni.tn. All rights reserved." styleClass="footer-text" />
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>
