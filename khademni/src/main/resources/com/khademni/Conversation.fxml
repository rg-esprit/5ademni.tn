<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.khademni.controller.ConversationController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: #f7f5f8; -fx-background: #f7f5f8;">

    <VBox spacing="0" style="-fx-background-color: #f7f5f8;">

        <!-- Header -->
        <fx:include source="header.fxml" />

        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 40 24 60 24;">

            <!-- Titre -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Mes Conversations"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <Label text="Gérez vos échanges avec les freelances et clients"
                       style="-fx-font-size: 16px; -fx-text-fill: #6b7280;"/>
            </VBox>

            <!-- Carte principale -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4); -fx-padding: 32 40 40 40;"
                  spacing="28" maxWidth="800" prefWidth="800">

                <!-- Label d'erreur/succès -->
                <Label fx:id="errorLabel" visible="false" managed="true"
                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-color: #fee2e2; -fx-background-radius: 8; -fx-text-fill: #dc2626;"/>

                <!-- Formulaire d'ajout -->
                <HBox spacing="20" alignment="BOTTOM_CENTER">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="ID Client" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                        <TextField fx:id="txtClientId" promptText="Ex: 12"
                                   style="-fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-padding: 0 10;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="ID Freelance" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                        <TextField fx:id="txtFreelanceId" promptText="Ex: 45"
                                   style="-fx-pref-height: 40; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-padding: 0 10;"/>
                    </VBox>

                    <Button text="Nouvelle Discussion" onAction="#handleAjouter"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 600; -fx-pref-height: 40; -fx-pref-width: 160; -fx-background-radius: 8; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-plus" iconColor="white" iconSize="14"/>
                        </graphic>
                    </Button>
                </HBox>

                <Separator style="-fx-background-color: #e5e7eb;"/>

                <!-- Tableau des conversations -->
                <TableView fx:id="tableConversations" prefHeight="400"
                           style="-fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                        <TableColumn fx:id="colClient" text="Client" prefWidth="180" />
                        <TableColumn fx:id="colFreelance" text="Freelance" prefWidth="180" />
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="180" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Section UPDATE - UNIQUEMENT la ComboBox (sans Archiver/Activer) -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Changer statut:" style="-fx-font-weight: 600;"/>
                    <ComboBox fx:id="cmbStatut" prefWidth="120" />
                    <Button text="Appliquer" onAction="#handleChangerStatut"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
                <!-- Boutons d'action - avec fx:id même s'ils sont cachés -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnArchiver" text="Archiver" visible="false" managed="false" />  <!-- Caché -->
                    <Button fx:id="btnActiver" text="Activer" visible="false" managed="false" />    <!-- Caché -->
                </HBox>
                <!-- Boutons d'action - UNIQUEMENT Supprimer et Ouvrir -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Supprimer" onAction="#handleSupprimer"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="Ouvrir la discussion" onAction="#handleOpenChat"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-comments" iconColor="white" iconSize="14"/>
                        </graphic>
                    </Button>
                </HBox>

            </VBox>
        </VBox>
    </VBox>
</ScrollPane>