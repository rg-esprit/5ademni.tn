<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/22"
       xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.khademni.controller.ArticlePublicationController"
       fitToWidth="true"
       styleClass="profile-scroll"
       stylesheets="@dashboard-article.css">
       <content>
              <VBox styleClass="profile-root">
                     <!-- Header -->
                     <fx:include source="../header.fxml" />
                     <!-- Contenu principal -->
                     <VBox fx:id="mainContent" styleClass="profile-root" alignment="TOP_CENTER"
                            spacing="20" style="-fx-padding: 20;">

                            <!-- Titre de la page -->
                            <Label text="Publications"
                                   styleClass="profile-page-title"
                                   style="-fx-padding: 20 0;" />

                            <!-- Bouton de filtrage -->
                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
                                   <Button fx:id="filterButton"
                                          text="Filtrer"
                                          styleClass="filter-button"
                                          onAction="#showFilterOptions" />
                            </HBox>

                            <!-- Conteneur principal -->
                            <HBox fx:id="mainContainer"
                                   spacing="20"
                                   alignment="CENTER"
                                   styleClass="main-container">
                                   <!-- Conteneur des articles -->
                                   <VBox fx:id="articlesBox"
                                          styleClass="profile-card"
                                          spacing="15"
                                          VBox.vgrow="ALWAYS">
                                          <TilePane fx:id="articlesContainer"
                                                 hgap="30"
                                                 vgap="30"
                                                 prefColumns="1"
                                                 alignment="CENTER"
                                                 tileAlignment="CENTER" />
                                                 
                                   </VBox>
                            </HBox>
                     </VBox>

                     <!-- Carte des commentaires (en avant-plan) -->
                     <!-- Carte des commentaires (en avant-plan) -->
                     <VBox fx:id="commentCard"
                            spacing="15"
                            visible="false"
                            managed="false"
                            styleClass="comment-card"
                            maxWidth="600"
                            maxHeight="400"
                            translateY="-1500">
                            <Button text="Masquer"
                                   style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 5 15; -fx-cursor: hand;"
                                   onAction="#hideCommentCard" />
                            <Label text="Commentaires"
                                   styleClass="profile-page-title"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6c0df2;" />
                            <ScrollPane fitToWidth="true"
                                   style="-fx-background-color: transparent; -fx-padding: 10;">
                                   <VBox fx:id="commentContainer"
                                          spacing="10"
                                          style="-fx-padding: 10;" />
                            </ScrollPane>
                     </VBox>

                     <!-- Carte des Gigs -->
                     <VBox fx:id="gigsCard"
                            alignment="TOP_CENTER"
                            spacing="15"
                            style="-fx-padding: 15; 
             -fx-background-color: white; 
             -fx-background-radius: 15; 
             -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.2), 8, 0, 0, 4);"
                            visible="false"
                            managed="false"
                            translateX="600"
                             translateY="-1500"
                            maxWidth="500"
                            maxHeight="1500">
                            <Button text="Masquer"
                                   style="-fx-background-color: #d32f2f; 
                   -fx-text-fill: white; 
                   -fx-background-radius: 15; 
                   -fx-padding: 5 15; 
                   -fx-cursor: hand;"
                                   onAction="#hideGigsCard" />
                            <Label text="Liste des Gigs"
                                   styleClass="profile-page-title"
                                   style="-fx-font-size: 18px; 
                  -fx-font-weight: bold; 
                  -fx-text-fill: #333;" />
                            <ScrollPane fitToWidth="true" style="-fx-padding: 10;">
                                   <TilePane fx:id="gigsContainer"
                                          hgap="15"
                                          vgap="15"
                                          alignment="CENTER"
                                          prefColumns="1"
                                          style="-fx-padding: 10;" />
                            </ScrollPane>
                     </VBox>
              </VBox>
       </content>
</ScrollPane>