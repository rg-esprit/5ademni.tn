<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.khademni.controller.PasswordConfirmationController" style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 15; -fx-background-radius: 15;">
    <children>
        <Label text="Confirmation requise" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
        <Label text="Veuillez confirmer votre mot de passe pour continuer." style="-fx-text-fill: #6b7280;" wrapText="true"/>
        <PasswordField fx:id="passwordField" promptText="Mot de passe" style="-fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-padding: 10;"/>
        <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;" visible="false" managed="false"/>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button text="Annuler" onAction="#onCancel" style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 8;"/>
            <Button text="Confirmer" onAction="#onConfirm" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 8; -fx-font-weight: bold;"/>
        </HBox>
    </children>
</VBox>
