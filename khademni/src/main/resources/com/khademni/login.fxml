<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.UserController"
    fitToWidth="true" fitToHeight="true" styleClass="root-scroll"
    style="-fx-background-color: #f7f5f8; -fx-background: #f7f5f8;">

    <VBox alignment="CENTER" spacing="0" styleClass="root"
        style="-fx-padding: 24;">

        <padding>
            <Insets top="40" bottom="40" left="24" right="24" />
        </padding>

        <!-- Brand Logo Top Center -->
        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 40 0;">
            <StackPane styleClass="logo-box" prefWidth="40" prefHeight="40" maxWidth="40"
                maxHeight="40">
                <FontIcon iconLiteral="fas-book-open" iconSize="24" iconColor="white" styleClass="icon-logo"/>
            </StackPane>
            <Label text="5ademni.tn" styleClass="brand-title" />
        </VBox>

        <!-- Bento Box Card Container -->
        <VBox styleClass="card" spacing="32" maxWidth="480" prefWidth="480"
            style="-fx-padding: 40;">

            <!-- Header Section -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Welcome Back" styleClass="heading" />
                <HBox alignment="CENTER" spacing="4">
                    <Label text="New here?" styleClass="subtitle-text" />
                    <Hyperlink text="Create account" onAction="#onCreateAccount"
                        styleClass="link-primary" />
                </HBox>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" text="" styleClass="error-label"
                visible="false" managed="false" />

            <!-- Form Section -->
            <VBox spacing="24">
                <!-- Email Field -->
                <VBox spacing="8">
                    <Label text="Email" styleClass="field-label" />
                    <StackPane styleClass="input-wrapper">
                        <HBox alignment="CENTER_LEFT" styleClass="input-container">
                            <FontIcon iconLiteral="fas-envelope" styleClass="input-icon" />
                            <TextField fx:id="emailField" promptText="name@company.com"
                                styleClass="input-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </StackPane>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Password" styleClass="field-label"
                            HBox.hgrow="ALWAYS" />
                        <Hyperlink text="Forgot Password?" onAction="#onForgotPassword"
                            styleClass="link-forgot" />
                    </HBox>
                    <StackPane styleClass="input-wrapper">
                        <HBox alignment="CENTER_LEFT" styleClass="input-container">
                            <FontIcon iconLiteral="fas-lock" styleClass="input-icon" />
                            <PasswordField fx:id="passwordField" promptText="Enter your password"
                                styleClass="input-field" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="plainPasswordField" promptText="Enter your password"
                                styleClass="input-field" visible="false" managed="false"
                                HBox.hgrow="ALWAYS" />
                            <Button fx:id="togglePasswordButton"
                                onAction="#togglePasswordVisibility"
                                styleClass="toggle-password-btn">
                                <graphic>
                                    <FontIcon iconLiteral="fas-eye" />
                                </graphic>
                            </Button>
                        </HBox>
                    </StackPane>
                </VBox>

                <!-- Sign In Button -->
                <Button fx:id="signInButton" text="Sign In" styleClass="button-primary"
                    onAction="#onSignIn" maxWidth="Infinity" graphicTextGap="8">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrow-right" styleClass="btn-icon-arrow" />
                    </graphic>
                </Button>
            </VBox>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="16" styleClass="divider-row">
                <Separator HBox.hgrow="ALWAYS" />
                <Label text="OR CONTINUE WITH" styleClass="divider-text" />
                <Separator HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Social Logins -->
            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="googleButton" text="Google" styleClass="social-button"
                    onAction="#onGoogleSignIn" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    graphicTextGap="12">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <Image
                                url="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" />
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="appleButton" text="Apple" styleClass="social-button"
                    onAction="#onAppleSignIn" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    graphicTextGap="12">
                    <graphic>
                        <FontIcon iconLiteral="fab-apple" styleClass="apple-icon" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Footer -->
        <VBox alignment="CENTER" style="-fx-padding: 32 0 0 0;">
            <Label text="© 2026 5ademni.tn. All rights reserved." styleClass="footer-text" />
        </VBox>

    </VBox>
</ScrollPane>