<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.khademni.controller.CategoryController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: #f7f5f8; -fx-background: #f7f5f8;">

    <VBox spacing="0" style="-fx-background-color: #f7f5f8;">

        <!-- Reusable Header -->
        <fx:include source="header.fxml" />

        <!-- Main Content -->
        <VBox alignment="TOP_CENTER" spacing="0"
              style="-fx-padding: 40 24 60 24;">

            <!-- Page Title -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-padding: 0 0 32 0;">
                <Label text="Category Management"
                       style="-fx-font-size: 26; -fx-font-weight: bold;" />
                <Label text="Create, update and manage service categories"
                       style="-fx-text-fill: #777;" />
            </VBox>

            <!-- Category Card -->
            <VBox spacing="0"
                  maxWidth="900"
                  prefWidth="900"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-padding: 0;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 5);">

                <!-- Top Section -->
                <VBox spacing="24"
                      style="-fx-padding: 32 40 32 40;">

                    <!-- Status Label -->
                    <Label fx:id="errorLabel"
                           text=""
                           visible="false"
                           managed="false"
                           style="-fx-text-fill: red;
                                  -fx-font-weight: bold;" />

                    <!-- Category Name -->
                    <VBox spacing="8">
                        <Label text="Category Name"
                               style="-fx-font-weight: bold;" />
                        <TextField fx:id="nameField"
                                   promptText="Enter category name"
                                   style="-fx-background-radius: 8;" />
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="8">
                        <Label text="Description"
                               style="-fx-font-weight: bold;" />
                        <TextArea fx:id="descField"
                                  promptText="Enter category description"
                                  prefRowCount="3"
                                  wrapText="true"
                                  style="-fx-background-radius: 8;" />
                    </VBox>

                    <!-- Active -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <CheckBox fx:id="activeCheck"
                                  text="Active Category" />
                    </HBox>

                    <!-- Buttons -->
                    <HBox spacing="16"
                          alignment="CENTER_RIGHT"
                          style="-fx-padding: 10 0 0 0;">

                        <Button text="Add"
                                onAction="#onAddCategory"
                                style="-fx-background-color: #6c63ff;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 8;" />

                        <Button text="Update"
                                onAction="#onUpdateCategory"
                                style="-fx-background-color: #4CAF50;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 8;" />

                        <Button text="Delete"
                                onAction="#onDeleteCategory"
                                style="-fx-background-color: #e53935;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 8;" />
                    </HBox>
                </VBox>

                <!-- Separator -->
                <Separator />

                <!-- Table Section -->
                <VBox spacing="20"
                      style="-fx-padding: 24 40 40 40;">

                    <Label text="Existing Categories"
                           style="-fx-font-size: 18;
                                  -fx-font-weight: bold;" />

                    <TableView fx:id="categoryTable"
                               prefHeight="350"
                               style="-fx-background-radius: 8;">

                        <columns>
                            <TableColumn fx:id="idCol"
                                         text="ID"
                                         prefWidth="80"/>
                            <TableColumn fx:id="nameCol"
                                         text="Name"
                                         prefWidth="200"/>
                            <TableColumn fx:id="descCol"
                                         text="Description"
                                         prefWidth="350"/>
                            <TableColumn fx:id="activeCol"
                                         text="Active"
                                         prefWidth="120"/>
                        </columns>
                    </TableView>

                </VBox>

            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
