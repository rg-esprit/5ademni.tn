<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.HeaderController"
    spacing="20" alignment="CENTER_LEFT" styleClass="header"
    stylesheets="@header.css"
    prefHeight="70" style="-fx-background-color: white; -fx-padding: 0 30 0 30;">

    <!-- Logo & Brand -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <ImageView fitHeight="36" preserveRatio="true" pickOnBounds="true" smooth="true">
            <image>
                <Image url="@logo.png" />
            </image>
        </ImageView>
        <Label text="5ademni.tn" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <!-- Navigation Links -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="jobsManagementLink" text="Jobs Management" onAction="#goToJobsAdmin"
            styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" visible="false" managed="false" />
        <Button text="Jobs &amp; Services" onAction="#onJobsAndServices" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
        <Button text="Contrat" onAction="#onContrat" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
        <Button text="Paiement" onAction="#onPaiement" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
        <Button text="Freelancer" onAction="#onFreelancer" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
        <Button text="Client" onAction="#onClient" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
        <Button text="Reviews" onAction="#onReviews" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
        <Button text="Blogs" onAction="#goToBlogs" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
        <Button text="Articles" onAction="#goToArticles" styleClass="nav-link" style="-fx-background-color: transparent; -fx-cursor: hand;" />
    </HBox>

    <Region HBox.hgrow="ALWAYS" />

    <!-- Profile Area -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Profile" onAction="#onProfile" styleClass="profile-button" />
        <StackPane prefHeight="40" prefWidth="40" maxHeight="40" maxWidth="40">
            <Circle radius="20" fill="#f3f4f6" stroke="#6c0df2" strokeWidth="2" opacity="0.3" />
            <Circle radius="20" style="-fx-fill: linear-gradient(to bottom, #6c0df2 0%, #8b5cf6 100%);" />
            <Label fx:id="headerAvatarInitials" text=""
                style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" />
            <ImageView fx:id="headerAvatarImage" fitWidth="40" fitHeight="40"
                preserveRatio="true" visible="false" managed="false" />
        </StackPane>
        <Button text="Logout" onAction="#onLogout" styleClass="logout-btn"
            style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-cursor: hand;" />
    </HBox>

</HBox>