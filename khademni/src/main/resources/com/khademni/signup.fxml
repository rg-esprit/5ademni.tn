<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.UserController"
    fitToWidth="true" fitToHeight="true" styleClass="root-scroll"
    style="-fx-background-color: #f7f5f8; -fx-background: #f7f5f8;">

    <VBox alignment="CENTER" spacing="0" styleClass="root"
        style="-fx-padding: 24;">

        <padding>
            <Insets top="40" bottom="40" left="24" right="24" />
        </padding>

        <!-- Brand Logo Top Center -->
        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 40 0;">
            <StackPane styleClass="logo-box" prefWidth="40" prefHeight="40" maxWidth="40"
                maxHeight="40">
                <Label styleClass="icon-logo" text="&#xe7b5;"
                    style="-fx-text-fill: white; -fx-font-size: 24;" />
            </StackPane>
            <Label text="5ademni.tn" styleClass="brand-title" />
        </VBox>

        <!-- Bento Box Card Container -->
        <VBox styleClass="card" spacing="32" maxWidth="480" prefWidth="480"
            style="-fx-padding: 40;">

            <!-- Header Section -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Create Account" styleClass="heading" />
                <HBox alignment="CENTER" spacing="4">
                    <Label text="Already have an account?" styleClass="subtitle-text" />
                    <Hyperlink text="Sign in" onAction="#onAlreadyHaveAccount"
                        styleClass="link-primary" />
                </HBox>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="signupErrorLabel" text="" styleClass="error-label"
                visible="false" managed="false" />

            <!-- Form Section -->
            <VBox spacing="24">
                <!-- Name Row -->
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="First Name" styleClass="field-label" />
                        <StackPane styleClass="input-wrapper">
                            <HBox alignment="CENTER_LEFT" styleClass="input-container">
                                <Label text="&#xe7fd;" styleClass="input-icon" />
                                <TextField fx:id="signupFirstNameField" promptText="John"
                                    styleClass="input-field" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </StackPane>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Last Name" styleClass="field-label" />
                        <StackPane styleClass="input-wrapper">
                            <HBox alignment="CENTER_LEFT" styleClass="input-container">
                                <Label text="&#xe7fd;" styleClass="input-icon" />
                                <TextField fx:id="signupLastNameField" promptText="Doe"
                                    styleClass="input-field" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </StackPane>
                    </VBox>
                </HBox>

                <!-- Date of Birth Field -->
                <VBox spacing="8">
                    <Label text="Date of Birth" styleClass="field-label" />
                    <StackPane styleClass="input-wrapper">
                        <HBox alignment="CENTER_LEFT" styleClass="input-container">
                            <Label text="&#xe916;" styleClass="input-icon" />
                            <DatePicker fx:id="signupDobPicker"
                                promptText="Select your date of birth"
                                styleClass="date-picker-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </StackPane>
                </VBox>

                <!-- Email Field -->
                <VBox spacing="8">
                    <Label text="Email" styleClass="field-label" />
                    <StackPane styleClass="input-wrapper">
                        <HBox alignment="CENTER_LEFT" styleClass="input-container">
                            <Label text="&#xe878;" styleClass="input-icon" />
                            <TextField fx:id="signupEmailField" promptText="name@company.com"
                                styleClass="input-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </StackPane>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="8">
                    <Label text="Password" styleClass="field-label" />
                    <StackPane styleClass="input-wrapper">
                        <HBox alignment="CENTER_LEFT" styleClass="input-container">
                            <Label text="&#xe897;" styleClass="input-icon" />
                            <PasswordField fx:id="signupPasswordField"
                                promptText="Create a password"
                                styleClass="input-field" HBox.hgrow="ALWAYS" />
                            <TextField fx:id="signupPlainPasswordField"
                                promptText="Create a password"
                                styleClass="input-field" visible="false" managed="false"
                                HBox.hgrow="ALWAYS" />
                            <Button fx:id="signupTogglePasswordButton" text="&#xe8f4;"
                                onAction="#toggleSignupPasswordVisibility"
                                styleClass="toggle-password-btn" />
                        </HBox>
                    </StackPane>
                </VBox>

                <!-- Confirm Password Field -->
                <VBox spacing="8">
                    <Label text="Confirm Password" styleClass="field-label" />
                    <StackPane styleClass="input-wrapper">
                        <HBox alignment="CENTER_LEFT" styleClass="input-container">
                            <Label text="&#xe897;" styleClass="input-icon" />
                            <PasswordField fx:id="signupConfirmPasswordField"
                                promptText="Confirm your password" styleClass="input-field"
                                HBox.hgrow="ALWAYS" />
                            <TextField fx:id="signupPlainConfirmPasswordField"
                                promptText="Confirm your password" styleClass="input-field"
                                visible="false" managed="false" HBox.hgrow="ALWAYS" />
                            <Button fx:id="signupToggleConfirmPasswordButton" text="&#xe8f4;"
                                onAction="#toggleSignupConfirmPasswordVisibility"
                                styleClass="toggle-password-btn" />
                        </HBox>
                    </StackPane>
                </VBox>

                <!-- Profile Image URL Field -->
                <VBox spacing="8">
                    <Label text="Profile Image URL (optional)" styleClass="field-label" />
                    <StackPane styleClass="input-wrapper">
                        <HBox alignment="CENTER_LEFT" styleClass="input-container">
                            <Label text="&#xe3f4;" styleClass="input-icon" />
                            <TextField fx:id="signupProfileImgField"
                                promptText="https://example.com/avatar.png"
                                styleClass="input-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </StackPane>
                </VBox>

                <!-- Bio Field -->
                <VBox spacing="8">
                    <Label text="Bio (optional)" styleClass="field-label" />
                    <StackPane styleClass="input-wrapper">
                        <TextArea fx:id="signupBioField" promptText="Tell us about yourself"
                            styleClass="input-field" prefRowCount="3" wrapText="true" />
                    </StackPane>
                </VBox>

                <!-- Sign Up Button -->
                <Button fx:id="signUpButton" text="Create Account" styleClass="button-primary"
                    onAction="#onSignUp" maxWidth="Infinity" graphicTextGap="8">
                    <graphic>
                        <Label text="&#xe5c8;" styleClass="btn-icon-arrow" />
                    </graphic>
                </Button>
            </VBox>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="16" styleClass="divider-row">
                <Separator HBox.hgrow="ALWAYS" />
                <Label text="OR CONTINUE WITH" styleClass="divider-text" />
                <Separator HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Social Logins -->
            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="googleButton" text="Google" styleClass="social-button"
                    onAction="#onSignupGoogleSignIn" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    graphicTextGap="12">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <Image
                                url="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" />
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="appleButton" text="Apple" styleClass="social-button"
                    onAction="#onSignupAppleSignIn" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    graphicTextGap="12">
                    <graphic>
                        <Label text="&#xf04f;" styleClass="apple-icon" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Footer -->
        <VBox alignment="CENTER" style="-fx-padding: 32 0 0 0;">
            <Label text="&#xa9; 2026 5ademni.tn. All rights reserved." styleClass="footer-text" />
        </VBox>

    </VBox>
</ScrollPane>