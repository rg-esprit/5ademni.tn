<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.ContratController"
    fitToWidth="true" fitToHeight="false" styleClass="bento-root"
    stylesheets="@contrat.css">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="bento-root">

        <fx:include source="header.fxml" />

        <VBox alignment="TOP_LEFT" spacing="0" style="-fx-padding: 40 40 100 40;">

            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 30 0;">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="MES CONTRATS" styleClass="kinetic-label-small" />
                    <Label text="Gestion des Accords" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #1a1a1a;" />
                </VBox>
                <HBox styleClass="floating-search" alignment="CENTER_LEFT" spacing="8">
                    <Label text="&#xe8b6;" style="-fx-font-family: 'Material Symbols Outlined'; -fx-font-size: 18; -fx-text-fill: #6b7280;" />
                    <TextField fx:id="searchField" promptText="Rechercher un contrat..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14;" />
                </HBox>
                <HBox spacing="10">
                    <Button text="💳 Paiements" onAction="#goToPaiement" styleClass="btn-secondary" style="-fx-cursor: hand;" />
                    <Button text="➕ Nouveau Contrat" onAction="#showNewContratForm" styleClass="btn-nouveau" style="-fx-cursor: hand;" />
                </HBox>
            </HBox>

            <HBox spacing="24" style="-fx-padding: 0 0 24 0;" alignment="CENTER_LEFT">
                <HBox styleClass="summary-card" spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <VBox styleClass="summary-icon-box" alignment="CENTER">
                        <Label text="&#x1F4DC;" style="-fx-font-size: 24;" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="TOTAL" styleClass="kinetic-label-small" style="-fx-text-fill: #6c0df2;" />
                        <Label fx:id="statTotal" text="0" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #17111f;" />
                    </VBox>
                </HBox>
                <HBox styleClass="summary-card" spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <VBox styleClass="summary-icon-box summary-icon-amber" alignment="CENTER">
                        <Label text="&#x23F3;" style="-fx-font-size: 24;" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="EN ATTENTE" styleClass="kinetic-label-small" style="-fx-text-fill: #f59e0b;" />
                        <Label fx:id="statEnAttente" text="0" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #17111f;" />
                    </VBox>
                </HBox>
                <HBox styleClass="summary-card" spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <VBox styleClass="summary-icon-box summary-icon-green" alignment="CENTER">
                        <Label text="&#x2705;" style="-fx-font-size: 24;" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="PAYÉS" styleClass="kinetic-label-small" style="-fx-text-fill: #0f9d66;" />
                        <Label fx:id="statPaye" text="0" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #17111f;" />
                    </VBox>
                </HBox>
            </HBox>

            <Label fx:id="countLabel" text="Chargement..." styleClass="result-count" style="-fx-padding: 0 0 16 0;" />
            <VBox fx:id="contratListContainer" spacing="16" />

            <VBox fx:id="contratFormView" visible="false" managed="false" alignment="TOP_CENTER" spacing="32" style="-fx-padding: 20 0;">
                <VBox spacing="24" styleClass="glass-card" maxWidth="800">
                      <Label text="Créer un Contrat" styleClass="bento-card-title" />
                      
                      <VBox spacing="8" fx:id="jobSelectionBox">
                          <Label text="OFFRE D'EMPLOI ACCEPTÉE" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                          <ComboBox fx:id="jobSelectionCombo" promptText="Choisir une offre avec un freelancer accepté..." 
                                    maxWidth="Infinity" styleClass="bento-input" />
                          <Label text="Un contrat doit être lié à une offre où vous avez accepté un candidat." style="-fx-text-fill: #9ca3af; -fx-font-size: 10;" />
                      </VBox>

                      <VBox spacing="20">
                          <HBox spacing="20" visible="false" managed="false">
                              <VBox spacing="8" HBox.hgrow="ALWAYS">
                                  <Label text="FREELANCER" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                  <TextField fx:id="freelancerSearchField" promptText="Rechercher..." styleClass="bento-input" />
                                  <VBox fx:id="freelancerSearchResults" />
                                  <HBox fx:id="selectedFreelancerBox">
                                      <Label fx:id="selectedFreelancerInitials" />
                                      <Label fx:id="selectedFreelancerName" />
                                      <Label fx:id="selectedFreelancerEmail" />
                                  </HBox>
                              </VBox>
                              <VBox spacing="8" HBox.hgrow="ALWAYS">
                                  <Label text="TITRE" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                  <TextField fx:id="titleField" styleClass="bento-input" />
                              </VBox>
                          </HBox>

                          <HBox spacing="20">
                              <VBox spacing="8" HBox.hgrow="ALWAYS">
                                  <Label text="PRIX (TND)" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                  <TextField fx:id="priceField" promptText="Ex: 500.0" styleClass="bento-input" />
                              </VBox>
                              <VBox spacing="8" HBox.hgrow="ALWAYS">
                                  <Label text="DATE D'ÉCHÉANCE" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                  <DatePicker fx:id="dateContratPicker" promptText="Choisir une date" maxWidth="Infinity" styleClass="bento-date-picker" />
                              </VBox>
                          </HBox>

                          <VBox spacing="12">
                              <Label text="TERMES ET CONDITIONS" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                              
                              <VBox spacing="10" style="-fx-background-color: #f5f3ff; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #ddd6fe; -fx-border-width: 1; -fx-border-style: dashed; -fx-border-radius: 12;">
                                  <Label text="💡 Décrivez brièvement votre besoin (l'IA fera le reste)" style="-fx-text-fill: #7c3aed; -fx-font-size: 11; -fx-font-weight: bold;" />
                                  <TextField fx:id="aiHintField" promptText="Ex: site e-commerce Symfony, 5 pages, livraison 2 semaines..." 
                                             style="-fx-background-color: white; -fx-border-radius: 8; -fx-padding: 10;" />
                                  <Button text="✨ Générer avec IA" onAction="#generateWithAi"
                                          style="-fx-background-color: linear-gradient(to right, #8b5cf6, #d946ef); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 20;" />
                              </VBox>

                              <TextArea fx:id="descriptionField" promptText="Description détaillée du travail..." 
                                        prefHeight="200" wrapText="true" styleClass="bento-input-textarea" />
                          </VBox>

                          <VBox spacing="8">
                              <Label text="NUMÉRO DE TÉLÉPHONE (obligatoire pour le paiement)" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                              <TextField fx:id="numTelephoneField" promptText="Ex: +216 12 345 678" styleClass="bento-input" />
                              <Label text="Ce numéro sera vérifié lors du paiement Stripe." style="-fx-text-fill: #9ca3af; -fx-font-size: 10;" />
                          </VBox>
                      </VBox>
                      <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;" visible="false" managed="false" />
                      <HBox alignment="CENTER_RIGHT" spacing="16" style="-fx-padding: 10 0 0 0;">
                          <Button text="ANNULER" onAction="#cancelForm" styleClass="btn-reset" />
                          <Button text="CRÉER LE CONTRAT" onAction="#saveContrat" styleClass="btn-nouveau" />
                      </HBox>
                </VBox>
            </VBox>

            <VBox alignment="CENTER" style="-fx-padding: 40 0 0 0;">
                <Label text="© 2026 5ademni.tn. All rights reserved." styleClass="footer-text" />
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>

