<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.ContratController"
    fitToWidth="true" fitToHeight="true" styleClass="root-scroll"
    stylesheets="@contrat.css"
    style="-fx-background-color: #f7f5f8; -fx-background: #f7f5f8;">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="root">
        
        <!-- Global Header -->
        <fx:include source="header.fxml" />

        <!-- Main Content Area -->
        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 40 24 60 24;">

            <!-- Main Card Container -->
            <VBox styleClass="card" spacing="28" maxWidth="900" prefWidth="900"
                style="-fx-padding: 0;">

                <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <!-- Tab 1: Liste des Contrats -->
                        <Tab fx:id="listTab" text="Liste des Contrats">
                            <VBox spacing="20" style="-fx-padding: 24;">
                                <!-- Header Section with Actions -->
                                <HBox alignment="CENTER_LEFT" spacing="16">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Liste des Contrats" styleClass="heading" />
                                        <Label text="Gérez vos contrats existants" styleClass="subtitle-text" />
                                    </VBox>
                                    
                                    <!-- Search Bar -->
                                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-container" prefWidth="300">
                                        <Label text="&#xe8b6;" styleClass="search-icon" />
                                        <TextField fx:id="searchField" promptText="Rechercher par ID ou Description..." 
                                                   styleClass="search-field" HBox.hgrow="ALWAYS" />
                                    </HBox>

                                    <Button text="Gestion Paiements" styleClass="button-secondary"
                                        onAction="#goToPaiement" style="-fx-background-color: #6c0df2; -fx-text-fill: white;">
                                        <graphic>
                                            <Label text="&#xf0d6;" styleClass="btn-icon-arrow" style="-fx-font-family: 'Font Awesome 5 Free Solid'; -fx-text-fill: white;" />
                                        </graphic>
                                    </Button>

                                    <Button text="Exporter PDF" styleClass="button-secondary"
                                        onAction="#generatePDF">
                                        <graphic>
                                            <Label text="&#xe415;" styleClass="btn-icon-arrow" />
                                        </graphic>
                                    </Button>
                                </HBox>

                                <!-- Statistics Cards -->
                                <HBox spacing="16" alignment="CENTER">
                                    <VBox alignment="CENTER" spacing="4" prefWidth="180"
                                          style="-fx-background-color: #f0ecff; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #d6ceff; -fx-border-radius: 12;">
                                        <Label text="Total" style="-fx-font-size: 12px; -fx-text-fill: #6c5ce7; -fx-font-weight: bold;" />
                                        <Label fx:id="statTotal" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #6c5ce7;" />
                                        <Label text="Contrats" style="-fx-font-size: 11px; -fx-text-fill: #8b7fe8;" />
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="4" prefWidth="180"
                                          style="-fx-background-color: #fff7e6; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #ffe0a3; -fx-border-radius: 12;">
                                        <Label text="En Attente" style="-fx-font-size: 12px; -fx-text-fill: #e67e22; -fx-font-weight: bold;" />
                                        <Label fx:id="statEnAttente" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" />
                                        <Label text="Contrats" style="-fx-font-size: 11px; -fx-text-fill: #d4a24e;" />
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="4" prefWidth="180"
                                          style="-fx-background-color: #e8f8e8; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #b5e6b5; -fx-border-radius: 12;">
                                        <Label text="Payé" style="-fx-font-size: 12px; -fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                                        <Label fx:id="statPaye" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                                        <Label text="Contrats" style="-fx-font-size: 11px; -fx-text-fill: #5cb85c;" />
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="4" prefWidth="180"
                                          style="-fx-background-color: #fde8e8; -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: #f5b5b5; -fx-border-radius: 12;">
                                        <Label text="Annulé" style="-fx-font-size: 12px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" />
                                        <Label fx:id="statAnnule" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                                        <Label text="Contrats" style="-fx-font-size: 11px; -fx-text-fill: #d9534f;" />
                                    </VBox>
                                </HBox>

                                <TableView fx:id="contratTable" VBox.vgrow="ALWAYS" minHeight="400">
                                    <columns>
                                        <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="150" />
                                        <TableColumn fx:id="colFreelancer" text="Freelancer ID" prefWidth="80" />
                                        <TableColumn fx:id="colClient" text="Client ID" prefWidth="80" />
                                        <TableColumn fx:id="colPrix" text="Prix (DT)" prefWidth="150" />
                                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" />
                                        <TableColumn fx:id="colDate" text="Date" prefWidth="100" />
                                        <TableColumn fx:id="colDesc" text="Description" prefWidth="200" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <!-- Floating Action Bar (Hidden by default) -->
                                <HBox fx:id="floatingActionBar" alignment="CENTER" spacing="16" visible="false" managed="false"
                                      style="-fx-background-color: #ffffff; -fx-padding: 12 24; -fx-background-radius: 50; 
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4); 
                                             -fx-border-color: #e5e7eb; -fx-border-radius: 50; -fx-border-width: 1;">
                                    <Button fx:id="fabEditBtn" text="Modifier" styleClass="button-primary" onAction="#onFabEdit" />
                                    <Button fx:id="fabDeleteBtn" text="Supprimer" styleClass="button-secondary" onAction="#onFabDelete" 
                                            style="-fx-background-color: #fef2f2; -fx-text-fill: #dc2626; -fx-border-color: #fecaca;" />
                                    <Button fx:id="fabPdfBtn" text="Exporter PDF" styleClass="button-secondary" onAction="#onFabPdf" 
                                            style="-fx-background-color: #ecfdf5; -fx-text-fill: #059669; -fx-border-color: #a7f3d0;" />
                                </HBox>

                            </VBox>
                        </Tab>

                        <!-- Tab 2: Ajouter un Contrat -->
                        <Tab fx:id="addTab" text="Ajouter un Contrat">
                            <VBox spacing="20" style="-fx-padding: 30;">
                                <Label text="Créer un nouveau contrat" styleClass="heading" />
                                <VBox spacing="15">
                                    <HBox spacing="15">
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Titre" style="-fx-font-weight: bold;"/>
                                            <TextField fx:id="titreField" promptText="Titre du contrat" prefHeight="40" styleClass="form-field"/>
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="ID Freelancer" style="-fx-font-weight: bold;"/>
                                            <TextField fx:id="idFreelancerField" promptText="Ex: 1440" prefHeight="40" maxWidth="Infinity" styleClass="form-field"/>
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="ID Client" style="-fx-font-weight: bold;"/>
                                            <TextField fx:id="idClientField" promptText="Ex: 5680" prefHeight="40" maxWidth="Infinity" styleClass="form-field"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="15">
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Prix (DT)" style="-fx-font-weight: bold;"/>
                                            <TextField fx:id="prixField" promptText="Ex: 500" prefHeight="40" styleClass="form-field"/>
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Date" style="-fx-font-weight: bold;"/>
                                            <DatePicker fx:id="dateContratPicker" prefHeight="40" maxWidth="Infinity" />
                                        </VBox>
                                    </HBox>
                                    <VBox spacing="5">
                                        <Label text="Description" style="-fx-font-weight: bold;"/>
                                        <TextArea fx:id="descriptionField" promptText="Description..." prefHeight="100" wrapText="true" styleClass="form-area"/>
                                    </VBox>
                                    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;" visible="false" managed="false" />
                                    <HBox alignment="CENTER_RIGHT" spacing="10">
                                        <Button text="Réinitialiser" onAction="#resetForm" prefWidth="120" prefHeight="40" styleClass="button-secondary"/>
                                        <Button text="Enregistrer" onAction="#saveContrat" prefWidth="150" prefHeight="40" styleClass="button-primary" style="-fx-background-color: #6c5ce7; -fx-text-fill: white;"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </Tab>

                        <!-- Tab 3: Informations -->
                        <Tab fx:id="infoTab" text="Informations">
                            <VBox spacing="25" style="-fx-padding: 30;">
                                <Label text="Détails du Contrat" styleClass="heading" />
                                <GridPane vgap="15" hgap="30">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="120" prefWidth="150" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    
                                    <Label text="ID Contrat:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoIdContrat" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                    <Label text="ID Client:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoIdClient" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                    <Label text="ID Freelancer:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoIdFreelancer" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                    <Label text="Freelancer:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoFreelancerName" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                    <Label text="Titre:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoTitre" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                                    <Label text="Prix:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoPrix" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                                    <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoDate" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                                    <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="7" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoStatut" text="-" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                                    <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="8" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="infoDescription" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                                </GridPane>
                                <Label text="Sélectionnez un contrat dans la liste pour voir les détails." styleClass="subtitle-text" fx:id="selectionPrompt" />
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>

            </VBox>

            <!-- Footer -->
            <VBox alignment="CENTER" style="-fx-padding: 24 0 0 0;">
                <Label text="© 2026 5ademni.tn. All rights reserved." styleClass="footer-text" />
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>
