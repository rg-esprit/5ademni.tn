<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.khademni.controller.ContratController"
    fitToWidth="true" fitToHeight="false" styleClass="bento-root"
    stylesheets="@contrat.css">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="bento-root">
        
        <!-- Global Header -->
        <fx:include source="header.fxml" />

        <VBox alignment="TOP_CENTER" spacing="48" style="-fx-padding: 60 40 100 40;">
            
            <!-- Bento Header -->
            <VBox alignment="CENTER" spacing="12">
                <Label text="GESTION DES CONTRATS" styleClass="kinetic-label-small" />
                <Label text="Contrats Actifs" styleClass="bento-title" />
            </VBox>

            <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" 
                     style="-fx-background-color: transparent; -fx-tab-min-width: 150;">
                <tabs>
                    <Tab text="VUE GRILLE">
                        <VBox spacing="32" style="-fx-padding: 30 0;">
                            <!-- Actions and Search -->
                            <HBox alignment="CENTER" spacing="24">
                                <HBox styleClass="floating-search">
                                    <Label text="&#xe8b6;" styleClass="search-icon" style="-fx-text-fill: #6c5ce7; -fx-font-family: 'Material Symbols Outlined';" />
                                    <TextField fx:id="searchField" promptText="Rechercher un contrat..." HBox.hgrow="ALWAYS" />
                                </HBox>
                                <Button text="Paiement Stripe" onAction="#goToPaiement" styleClass="cyber-price" 
                                        style="-fx-cursor: hand; -fx-background-radius: 50;" />
                            </HBox>

                            <!-- Statistics (Bento Style) -->
                            <HBox spacing="16" alignment="CENTER">
                                <VBox styleClass="glass-card" prefWidth="250" alignment="CENTER" spacing="10">
                                    <Label text="TOTAL" styleClass="kinetic-label-small" />
                                    <Label fx:id="statTotal" text="0" style="-fx-font-size: 36; -fx-text-fill: #1a1a1a; -fx-font-weight: 900;" />
                                </VBox>
                                <VBox styleClass="glass-card" prefWidth="250" alignment="CENTER" spacing="10" style="-fx-border-color: #27ae60;">
                                    <Label text="PAYES" styleClass="kinetic-label-small" style="-fx-text-fill: #27ae60;" />
                                    <Label fx:id="statPaye" text="0" style="-fx-font-size: 36; -fx-text-fill: #27ae60; -fx-font-weight: 900;" />
                                </VBox>
                                <VBox styleClass="glass-card" prefWidth="250" alignment="CENTER" spacing="10" style="-fx-border-color: #f59e0b;">
                                    <Label text="EN ATTENTE" styleClass="kinetic-label-small" style="-fx-text-fill: #f59e0b;" />
                                    <Label fx:id="statEnAttente" text="0" style="-fx-font-size: 36; -fx-text-fill: #f59e0b; -fx-font-weight: 900;" />
                                </VBox>
                            </HBox>

                            <!-- Bento Grid for Contracts -->
                            <FlowPane fx:id="bentoGrid" hgap="24" vgap="24" alignment="TOP_CENTER" prefWrapLength="1200" />
                        </VBox>
                    </Tab>
                    
                    <Tab text="NOUVEAU CONTRAT">
                        <VBox alignment="TOP_CENTER" spacing="32" style="-fx-padding: 40 0;">
                            <VBox spacing="24" styleClass="glass-card" maxWidth="800">
                                 <Label text="Creer un Contrat" styleClass="bento-card-title" />
                                 <VBox spacing="20">
                                     <HBox spacing="20">
                                         <VBox spacing="8" HBox.hgrow="ALWAYS">
                                             <Label text="FREELANCER" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                             <TextField fx:id="freelancerSearchField" promptText="Rechercher un freelancer par nom..." styleClass="bento-input" />
                                             <VBox fx:id="freelancerSearchResults" spacing="0" visible="false" managed="false" maxHeight="200"
                                                  style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 2);" />
                                             <HBox fx:id="selectedFreelancerBox" spacing="12" alignment="CENTER_LEFT"
                                                  visible="false" managed="false"
                                                  style="-fx-background-color: #f0f0ff; -fx-padding: 10 16; -fx-background-radius: 10; -fx-border-color: #6c5ce7; -fx-border-radius: 10;">
                                                 <Label fx:id="selectedFreelancerInitials" text=""
                                                        style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 12; -fx-background-radius: 50;" />
                                                 <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                     <Label fx:id="selectedFreelancerName" text="" style="-fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />
                                                     <Label fx:id="selectedFreelancerEmail" text="" style="-fx-text-fill: #6b7280; -fx-font-size: 11;" />
                                                 </VBox>
                                                 <Button text="X" onAction="#clearFreelancerSelection"
                                                         style="-fx-background-color: transparent; -fx-text-fill: #999; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14;" />
                                             </HBox>
                                         </VBox>

                                         <VBox spacing="8" HBox.hgrow="ALWAYS">
                                             <Label text="TITRE DU CONTRAT" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                             <TextField fx:id="titleField" promptText="Ex: Developpement site web" styleClass="bento-input" />
                                         </VBox>
                                     </HBox>

                                     <HBox spacing="20">
                                         <VBox spacing="8" HBox.hgrow="ALWAYS">
                                             <Label text="PRIX (DT)" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                             <TextField fx:id="priceField" promptText="Ex: 500.0" styleClass="bento-input" />
                                         </VBox>

                                         <VBox spacing="8" HBox.hgrow="ALWAYS">
                                             <Label text="DATE D'EXPIRATION" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                             <DatePicker fx:id="dateContratPicker" promptText="Choisir une date" styleClass="bento-date-picker" maxWidth="Infinity" />
                                         </VBox>
                                     </HBox>

                                     <VBox spacing="8">
                                         <Label text="TERMES ET CONDITIONS" styleClass="kinetic-label-small" style="-fx-font-size: 10;" />
                                         <TextArea fx:id="descriptionField" promptText="Description detaillee du travail..." 
                                                   styleClass="bento-input-textarea" prefHeight="150" wrapText="true" />
                                     </VBox>

                                     <VBox spacing="8">
                                         <Label text="NUMERO DE TELEPHONE (obligatoire pour le paiement)" styleClass="kinetic-label-small" style="-fx-font-size: 10; -fx-text-fill: #6c5ce7;" />
                                         <TextField fx:id="numTelephoneField" promptText="Ex: +216 12 345 678" styleClass="bento-input" />
                                         <Label text="Ce numero sera verifie lors du paiement Stripe." style="-fx-text-fill: #9ca3af; -fx-font-size: 10;" />
                                     </VBox>
                                 </VBox>

                                 <Label fx:id="errorLabel" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;" visible="false" managed="false" />
                                 
                                 <HBox alignment="CENTER_RIGHT" spacing="16" style="-fx-padding: 10 0 0 0;">
                                     <Button text="REINITIALISER" onAction="#resetForm" styleClass="pagination-neon" />
                                     <Button text="CREER LE CONTRAT" onAction="#saveContrat" styleClass="cyber-price" />
                                 </HBox>
                            </VBox>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>

            <!-- Floating Action Bar -->
            <HBox fx:id="floatingActionBar" alignment="CENTER" spacing="24" visible="false" managed="false"
                  style="-fx-background-color: rgba(0,0,0,0.8); -fx-padding: 16 32; -fx-background-radius: 100; 
                         -fx-border-color: rgba(108, 92, 231, 0.5); -fx-border-width: 1;">
                <Button fx:id="fabEditBtn" text="Edit" styleClass="button-primary" onAction="#onFabEdit" 
                        style="-fx-background-radius: 100; -fx-background-color: #6c5ce7;" />
                <Button fx:id="fabDeleteBtn" text="Terminate" onAction="#onFabDelete" 
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: #ef4444; -fx-border-radius: 100;" />
                <Button fx:id="fabPdfBtn" text="Generate PDF" onAction="#onFabPdf" 
                        style="-fx-background-color: white; -fx-text-fill: black; -fx-border-radius: 100; -fx-font-weight: bold;" />
            </HBox>

        </VBox>
    </VBox>
</ScrollPane>
