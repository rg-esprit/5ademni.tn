{% extends 'base.html.twig' %}

{% block title %}Admin Categories | 5ademni.tn{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="page-shell admin-page">
        {% include 'partials/_header.html.twig' %}

        <main class="admin-wrap">
            <section class="admin-topbar">
                <div>
                    <h1>Category Management</h1>
                    <p>Create, activate, and monitor categories used by gigs.</p>
                </div>
                <nav class="admin-nav" aria-label="Admin pages">
                    <a href="{{ path('app_admin_dashboard') }}">Dashboard</a>
                    <a class="is-active" href="{{ path('app_admin_categories') }}">Categories</a>
                    <a href="{{ path('app_admin_gigs') }}">Gigs</a>
                </nav>
            </section>

            <section class="admin-grid-two">
                <article class="admin-panel">
                    <header>
                        <h2>New Category</h2>
                        <span>Business rule: unique name</span>
                    </header>

                    <form method="post" class="admin-form-stack">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_category_create') }}">

                        <label>
                            <span>Name</span>
                            <input type="text" name="name" value="{{ form.name }}" placeholder="Category name">
                            {% if errors.name is defined %}<small class="field-error">{{ errors.name }}</small>{% endif %}
                        </label>

                        <label>
                            <span>Description</span>
                            <textarea name="description" rows="4" placeholder="Category description">{{ form.description }}</textarea>
                            {% if errors.description is defined %}<small class="field-error">{{ errors.description }}</small>{% endif %}
                        </label>

                        <label class="checkbox-row">
                            <input type="checkbox" name="is_active" value="1" {% if form.is_active %}checked{% endif %}>
                            <span>Active category</span>
                        </label>

                        <button class="btn-primary" type="submit">Create Category</button>
                    </form>
                </article>

                <article class="admin-panel">
                    <header>
                        <h2>Category Search</h2>
                        <span>{{ categories|length }} result{{ categories|length == 1 ? '' : 's' }}</span>
                    </header>

                    <form method="get" class="admin-search-bar">
                        <input type="text" name="q" value="{{ filters.q }}" placeholder="Search by name or description">
                        <select name="status">
                            <option value="all" {% if filters.status == 'all' %}selected{% endif %}>All</option>
                            <option value="active" {% if filters.status == 'active' %}selected{% endif %}>Active</option>
                            <option value="inactive" {% if filters.status == 'inactive' %}selected{% endif %}>Inactive</option>
                        </select>
                        <button class="btn-secondary" type="submit">Filter</button>
                        <a class="btn-soft" href="{{ path('app_admin_categories') }}">Reset</a>
                    </form>

                    <div class="mini-stats">
                        <span>Total: {{ dashboard.total_categories }}</span>
                        <span>Active: {{ dashboard.active_categories }}</span>
                        <span>Inactive: {{ dashboard.inactive_categories }}</span>
                    </div>
                </article>
            </section>

            <section class="admin-panel">
                <header>
                    <h2>All Categories</h2>
                    <span>Delete is blocked if gigs exist</span>
                </header>

                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Gigs</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for category in categories %}
                                {% set stats = attribute(distribution_by_id, category.id)|default(null) %}
                                {% set gigs_count = stats ? stats.gig_count : 0 %}
                                <tr>
                                    <td>#{{ category.id }}</td>
                                    <td>{{ category.name }}</td>
                                    <td>{{ category.description ?: '-' }}</td>
                                    <td>{{ gigs_count }}</td>
                                    <td>
                                        <span class="status-pill {{ category.active ? 'status-active' : 'status-inactive' }}">{{ category.active ? 'Active' : 'Inactive' }}</span>
                                    </td>
                                    <td>
                                        <div class="table-actions">
                                            <form method="post" action="{{ path('app_admin_category_toggle', {id: category.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_category_' ~ category.id) }}">
                                                <button class="btn-soft" type="submit">{{ category.active ? 'Deactivate' : 'Activate' }}</button>
                                            </form>
                                            <form method="post" action="{{ path('app_admin_category_delete', {id: category.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_category_' ~ category.id) }}">
                                                <button class="btn-danger" type="submit">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="empty-row">No categories found.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
{% endblock %}
