{% extends 'base.html.twig' %}

{% block title %}Admin — Modifier Paiement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/contrat_web.css') }}">
{% endblock %}

{% block body %}
{% include 'partials/_header.html.twig' %}
<div class="bento-root" style="max-width: 800px; margin: 0 auto;">
    <div class="top-bar">
        <div>
            <span class="kinetic-label-small">ADMIN // EDITION</span>
            <h1 class="bento-title">Modifier Paiement</h1>
        </div>
        <div>
            {{ include('payment/_delete_form.html.twig') }}
        </div>
    </div>
    
    <div class="glass-card">
        {{ include('payment/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>
    
    <div style="margin-top: 20px;">
        <a href="{{ path('admin_payment_index') }}" style="color: #6c5ce7; text-decoration: none; font-weight: 600;">← Retour à la liste</a>
    </div>
</div>
{% endblock %}
