{% extends 'base.html.twig' %}

{% block title %}Sign In | 5ademni.tn{% endblock %}
{% block body_class %}auth-body{% endblock %}

{% block body %}
    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-brand">
                <img class="brand-mark brand-mark-large" src="{{ asset('images/logo.png') }}" alt="5ademni.tn logo">
                <h1>Welcome Back</h1>
                <p>Sign in to continue to your account.</p>
            </div>

            {% if error %}
                <div class="form-banner form-banner-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {{ form_start(login_form, {attr: {class: 'form-grid'}}) }}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="field-group">
                    {{ form_label(login_form.email) }}
                    {{ form_widget(login_form.email) }}
                    {{ form_errors(login_form.email) }}
                </div>

                <div class="field-group">
                    {{ form_label(login_form.password) }}
                    {{ form_widget(login_form.password) }}
                    {{ form_errors(login_form.password) }}
                </div>

                <button class="primary-button" type="submit">Sign In</button>
            {{ form_end(login_form, {render_rest: false}) }}

            <div class="divider"><span>or continue with Face ID</span></div>

            <section class="face-panel">
                <form method="post" action="{{ path('app_face_login') }}" enctype="multipart/form-data" class="form-grid face-form" data-face-camera-form data-face-camera-count="4">
                    <input type="hidden" name="_token" value="{{ face_login_csrf_token }}">

                    <div class="field-group">
                        <span class="field-label">Face ID Camera</span>
                        <video class="face-video" data-face-camera-video autoplay playsinline muted></video>
                        <input type="file" name="frames[]" accept="image/jpeg" multiple hidden data-face-camera-frames tabindex="-1">
                        <p class="helper-text face-status" data-face-camera-status>Use your device camera. We will capture a few live frames when you continue.</p>
                        <noscript>
                            <p class="helper-text">Face ID requires JavaScript and camera access.</p>
                        </noscript>
                    </div>

                    <div class="face-camera-actions">
                        <button class="ghost-button" type="button" data-face-camera-toggle>Start Camera</button>
                        <button class="secondary-button" type="submit" data-face-camera-submit>Face ID Login</button>
                    </div>
                </form>
            </section>

            <p class="auth-switch">New here? <a href="{{ path('app_signup') }}">Create account</a></p>
        </section>
    </main>
{% endblock %}
