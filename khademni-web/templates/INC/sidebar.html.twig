<style>
.sidebar{
    --icon-size: 22px;
}
.menu-link{
    display:flex;
    align-items:center;
    gap:10px;
    padding:10px 8px;
    border-radius:10px;
    text-decoration:none;
    color:#7e739a;
    transition:0.2s;
}

.menu-link:hover{
    background:#f3edff;
    color:#4b2ca3;
}

.menu-link.active{
    background:#ede6ff;
    color:#4b2ca3;
    font-weight:600;
}
.icon-wrap{
    width:var(--icon-size);
    height:var(--icon-size);
    display:flex;
    align-items:center;
    justify-content:center;
    color:#7c3aed;
}
.icon-wrap svg{
    width:100%;
    height:100%;
}

.menu-group{position:relative}
.menu-toggle{
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:10px;
    width:100%;
}
.submenu{
    display:none;
    margin-top:6px;
    padding-left:8px;
    border-left:2px solid #e7defd;
}
.menu-group.open .submenu{display:block}
.menu-group.open .arrow{transform:rotate(180deg)}
.arrow{
    font-size:10px;
    transition:transform .25s;
    margin-left:auto;
}
.submenu a{
    color:#7e739a;
    font-size:14px;
}
.submenu a:hover{color:#4b2ca3}
.submenu a.active{color:#4b2ca3;font-weight:600}
.sidebar {
    background: rgba(124, 58, 237, 0.05); /* violet transparent */
    backdrop-filter: blur(5px); /* effet flou (glassmorphism) */
    -webkit-backdrop-filter: blur(10px); /* pour compatibilité */
    
    border-right: 1px solid rgba(124, 58, 237, 0.2);
}
</style>

<script>
document.querySelectorAll('.menu-toggle').forEach(toggle => {
    toggle.addEventListener('click', (e) => {
        e.preventDefault();
        toggle.parentElement.classList.toggle('open');
    });
});
</script>