{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block stylesheets %}
	<style>
		.page {
			margin: 0 auto;
			padding: 30px 40px;
			max-width: 1400px; /* Vous pouvez ajuster cette largeur maximale selon vos besoins */
		}
		.panel {
			background: #fff;
			border: 1px solid #ece7fb;
			border-radius: 16px;
			box-shadow: 0 8px 24px rgba(124, 58, 237, .08);
			padding: 16px;
		}
		.table-wrap {
			overflow: auto;
			border: 1px solid #f0ebff;
			border-radius: 12px;
		}
		table {
			width: 100%;
			border-collapse: separate;
			border-spacing: 0;
			min-width: 900px;
			background: #fff;
		}
		thead th {
			position: sticky;
			top: 0;
			z-index: 1;
			background: #faf8ff;
			color: #6f6291;
			font-weight: 700;
			font-size: 13px;
			text-transform: uppercase;
			letter-spacing: 0.02em;
			border-bottom: 1px solid #ece7fb;
		}
		th,
		td {
			padding: 12px 14px;
			text-align: left
		}
		tbody tr {
			transition: background 0.15s ease
		}
		tbody tr:nth-child(even) {
			background: #fcfbff
		}
		tbody tr:hover {
			background: #f5f1ff
		}
		td {
			border-bottom: 1px solid #f4efff
		}

		.badge {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 4px 10px;
			border-radius: 999px;
			font-size: 12px;
			font-weight: 700;
		}
		.badge::before {
			content: '';
			width: 7px;
			height: 7px;
			border-radius: 50%;
		}
		.badge-ok {
			background: #e8f7ee;
			color: #1f8a4b
		}
		.badge-ok::before {
			background: #22c55e
		}
		.badge-off {
			background: #fdecec;
			color: #b42323
		}
		.badge-off::before {
			background: #ef4444
		}

		.actions {
			display: flex;
			gap: 8px;
			align-items: center
		}
		.btn {
			border: none;
			border-radius: 10px;
			padding: 8px 12px;
			cursor: pointer;
			font-weight: 600;
		}
		.btn-ghost {
			background: #efeaff;
			color: #4b2ca3;
			border: 1px solid #d9ccff;
			text-decoration: none;
			display: inline-block;
		}
		.btn-danger {
			background: #ef4444;
			color: #fff
		}
		.btn-danger:hover {
			background: #dc2626
		}
	.search-filter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    gap: 12px;
}

.search-form {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
}

/* 🔍 Search box */
.search-box {
    position: relative;
    flex: 1;
}

.search-input {
    width: 100%;
    padding: 12px 45px 12px 14px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    font-size: 14px;
    background: #fafafa;
    transition: all 0.3s ease;
}

.search-input:focus {
    outline: none;
    border-color: #7c3aed;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
}

/* 🔍 Button icon inside input */
.search-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: #7c3aed;
    border: none;
    color: white;
    border-radius: 10px;
    padding: 6px 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.search-btn:hover {
    background: #5b21b6;
}

/* 🎯 Filter select */
.filter-select {
    padding: 11px 14px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    background: #fafafa;
    cursor: pointer;
    transition: 0.3s;
}

.filter-select:focus {
    outline: none;
    border-color: #7c3aed;
    background: #fff;
}

		 
		.btn-search {
			background-color: #7c3aed;
			color: white;
			border: none;
			border-radius: 8px;
			padding: 10px 20px;
			cursor: pointer;
			font-size: 14px;
			font-weight: bold;
			transition: background-color 0.3s ease, transform 0.2s ease;
		}

		.btn-search:hover {
			background-color: #5b21b6;
			transform: translateY(-2px);
		}
		.btn-add {
			display: inline-flex;
			align-items: center;
			gap: 6px;

			background: linear-gradient(135deg, #7c3aed, #a78bfa);
			color: white;

			border: none;
			border-radius: 10px;
			padding: 8px 14px; /* Réduit de 12px 18px à 8px 14px */

			font-weight: 600;
			font-size: 13px; /* Réduit de 14px à 13px */

			cursor: pointer;
			box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25); /* Ombre réduite */

			transition: all 0.3s ease;
			position: relative;
			overflow: hidden;
			text-decoration: none;
		}

		/* ICON */
		.btn-add .icon {
			font-size: 16px;
			transition: transform 0.3s ease;
		}

		/* HOVER EFFECT */
		.btn-add:hover {
			transform: translateY(-2px) scale(1.02); /* Effet réduit */
			box-shadow: 0 8px 20px rgba(124, 58, 237, 0.35);
		}

		/* ICON ROTATION */
		.btn-add:hover .icon {
			transform: rotate(90deg);
		}

		/* CLICK EFFECT */
		.btn-add:active {
			transform: scale(0.95);
		}

		/* GLOW ANIMATION */
		.btn-add::after {
			content: '';
			position: absolute;
			top: 0;
			left: -100%;
			width: 20%;
			height: 100%;
			background: linear-gradient(120deg,transparent,rgba(255,255,255,.4),transparent);
			transition: 0.4s;
		}
		.header-container {
			display: flex;
			justify-content: space-between;
			align-items: center;
			
			    margin: 20px auto;
		}

		.header-container h1 {
			margin: 0;
			
		}

		/* 🎨 Modern KnpPaginator Styling */
		.pagination {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 12px;
			margin: 30px 0;
			padding: 15px;
			background: rgba(255, 255, 255, 0.4);
			backdrop-filter: blur(15px);
			border-radius: 16px;
			border: 1px solid rgba(124, 58, 237, 0.1);
			box-shadow: 0 4px 20px rgba(124, 58, 237, 0.04);
		}

		.pagination a, 
		.pagination span {
			display: flex;
			align-items: center;
			justify-content: center;
			min-width: 40px;
			height: 40px;
			padding: 0 10px;
			border-radius: 12px;
			font-weight: 800;
			font-size: 14px;
			text-decoration: none;
			transition: all 0.3s ease;
			cursor: pointer;
		}

		.pagination a {
			background: white;
			color: #4b5563;
			border: 1px solid #f3f4f6;
		}

		.pagination a:hover {
			background: #ffffff;
			color: #7c3aed;
			border-color: #7c3aed;
			transform: translateY(-3px);
			box-shadow: 0 8px 16px rgba(124, 58, 237, 0.1);
		}

		.pagination .current {
			background: linear-gradient(135deg, #7c3aed, #db2777);
			color: white;
			border: none;
			box-shadow: 0 6px 15px rgba(124, 58, 237, 0.3);
		}

		.pagination .disabled {
			opacity: 0.3;
			pointer-events: none;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="page-shell">
		{% include 'partials/_header.html.twig' %}

		<main class="page-content">
	<div class="page">
		<div class="header-container">
			<h1>Liste des articles</h1>
			<a href="{{ path('article_new') }}" class="btn-add">
				<span class="icon">＋</span>
				<span>Ajouter</span>
			</a>
		</div>
		<div class="search-filter">
    <form method="GET" action="{{ path('article_list') }}" class="search-form">

        <div class="search-box">
            <input 
                type="text" 
                name="search" 
                id="dynamic-search-input"
                placeholder="Rechercher un article..." 
                value="{{ app.request.get('search') }}"
                class="search-input"
                autocomplete="off"
            >
            <div id="search-clear-btn" class="search-clear" style="display:none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </div>
            <button type="submit" class="search-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="8" cy="8" r="6"></circle>
                    <line x1="13" y1="13" x2="17" y2="17"></line>
                </svg>
            </button>
        </div>

        <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="">Tous</option>
            <option value="VISIBLE" {% if app.request.get('status') == 'VISIBLE' %} selected {% endif %}>Visible</option>
            <option value="MASQUE" {% if app.request.get('status') == 'MASQUE' %} selected {% endif %}>Masqué</option>
        </select>

    </form>
    <div id="search-results-count" class="search-results-count"></div>
</div>

		<div class="panel table-wrap">
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Titre</th>
						<th>Status</th>
						<th>Date</th>
						<th>Favoris</th>
						<th>Commentaires</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody id="articles-table-body">
					{% for row in pagination %}
						{% set article = row[0] %}
						<tr>
							<td>#{{ article.id }}</td>
							<td>{{ article.title }}</td>
							<td>
								{% if article.status == 'VISIBLE' %}
									<span class="badge badge-ok">VISIBLE</span>
								{% else %}
									<span class="badge badge-off">MASQUE</span>
								{% endif %}
							</td>
							<td>{{ article.createdAt ? article.createdAt|date('Y-m-d H:i') : '' }}</td>
							<td>{{ row.favorisCount }}</td>
							<td>{{ row.commentairesCount }}</td>
							<td class="actions">
								<a class="btn btn-ghost" href="{{ path('article_edit', {id: article.id}) }}">Modifier</a>
								<form method="POST" action="{{ path('article_delete', {id: article.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet article ?');">
									<input type="hidden" name="_token" value="{{ csrf_token('delete_article_' ~ article.id) }}">
									<button class="btn btn-danger" type="submit">Supprimer</button>
								</form>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="7">Aucun article.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		<div class="pagination">
			{{ knp_pagination_render(pagination) }}
		</div>
		
	</div>
		</main>
	</div>
	

<script>
document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('dynamic-search-input');
    const tableBody = document.getElementById('articles-table-body');
    const clearBtn = document.getElementById('search-clear-btn');
    const resultsCount = document.getElementById('search-results-count');
    const allRows = Array.from(tableBody.querySelectorAll('tr'));

    function filterTable() {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        clearBtn.style.display = query.length > 0 ? 'flex' : 'none';

        allRows.forEach(row => {
            const cells = row.querySelectorAll('td');
            if (cells.length <= 1) return;

            const text = Array.from(cells).map(c => c.textContent.toLowerCase()).join(' ');
            const match = text.includes(query);
            
            row.style.display = match ? '' : 'none';
            if (match && query.length > 0) {
                row.style.animation = 'rowFadeIn 0.3s ease';
            } else {
                row.style.animation = '';
            }
            if (match) visibleCount++;
        });

        if (query.length > 0) {
            resultsCount.textContent = visibleCount + ' résultat' + (visibleCount !== 1 ? 's' : '') + ' trouvé' + (visibleCount !== 1 ? 's' : '');
            resultsCount.style.display = 'inline-block';
        } else {
            resultsCount.style.display = 'none';
        }
    }

    searchInput.addEventListener('input', filterTable);

    clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        filterTable();
        searchInput.focus();
    });

    if (searchInput.value.trim().length > 0) {
        filterTable();
    }
});
</script>

<style>
@keyframes rowFadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
}

.search-clear {
    position: absolute;
    right: 42px;
    top: 50%;
    transform: translateY(-50%);
    background: #e5e7eb;
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #6b7280;
    transition: all 0.2s;
}

.search-clear:hover {
    background: #d1d5db;
    color: #374151;
}

.search-results-count {
    display: none;
    font-size: 13px;
    color: #7c3aed;
    font-weight: 600;
    padding: 4px 12px;
    background: #f5f3ff;
    border-radius: 20px;
    border: 1px solid #ede9fe;
    white-space: nowrap;
    margin-left: 8px;
}

#dynamic-search-input:not(:placeholder-shown) {
    border-color: #7c3aed;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.08);
}
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{% if app.request.query.get('download_pdf') %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                const url = new URL(window.location.href);
                url.searchParams.delete('download_pdf');
                window.history.replaceState({}, document.title, url);

                Swal.fire({
                    title: 'Article créé avec succès ! 🎉',
                    text: "Voulez-vous télécharger les informations en PDF ?",
                    icon: 'success',
                    showCancelButton: true,
                    confirmButtonColor: '#7c3aed',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Oui, Télécharger',
                    cancelButtonText: 'Non, Merci',
                    background: '#ffffff',
                    customClass: {
                        popup: 'rounded-xl shadow-2xl border border-gray-100',
                        title: 'text-2xl font-bold text-gray-800',
                        confirmButton: 'rounded-lg font-bold px-6 py-2.5',
                        cancelButton: 'rounded-lg font-bold px-6 py-2.5'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = "{{ path('article_download_pdf', {id: app.request.query.get('download_pdf')}) }}";
                    }
                });
            }, 300);
        });
    </script>
{% endif %}

{% endblock %}
