{% extends 'base.html.twig' %}

{% block title %}Articles | 5ademni.tn{% endblock %}

{% block body %}{% include 'partials/_header.html.twig' %}
<div class="page">
    <div class="header-section">
        <h1>Articles</h1>
        <div class="search-container">
            <form method="GET" action="{{ path('article_publications') }}" id="search-form">
                <input type="text" name="q" id="search-q" placeholder="Rechercher avec votre voix..." value="{{ q }}">
                <button type="button" id="voice-btn" class="voice-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                        <line x1="12" y1="19" x2="12" y2="23"></line>
                        <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                </button>
                <button type="submit" class="search-submit">Rechercher</button>
            </form>
        </div>
        <div class="filters">
            <a class="btn filter-btn {{ sort == 'favoris' ? 'active' : '' }}" href="{{ path('article_publications', {sort: 'favoris', q: q}) }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                </svg>
                Favoris
            </a>
            <a class="btn filter-btn {{ sort == 'commentaires' ? 'active' : '' }}" href="{{ path('article_publications', {sort: 'commentaires', q: q}) }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                Commentaires
            </a>
        </div>
    </div>

	{% for article in articles %}
		<div class="card">


			<div class="card-content">


				{% if article.imagePath %}
					{% set filename = article.imagePath|split('\\')|last %}
					<img src="{{ asset('uploads/images/' ~ filename) }}" class="article-image">
				{% endif %}

				{# LIGNE VERTICALE #}
				<div class="divider-vertical"></div>

				<div class="card-main">
					<h3>{{ article.title }}</h3>
					<p class="card-text">{{ article.content }}</p>
				</div>


				{% if article.createdAt %}
					{% set now = "now"|date("U") %}
					{% set created = article.createdAt|date("U") %}
					{% set diff = now - created %}

					<span class="time-ago">
						{% if diff < 60 %}
							il y a
							{{ diff }}
							sec
						{% elseif diff < 3600 %}
							il y a
							{{ (diff / 60)|round }}
							min
						{% elseif diff < 86400 %}
							il y a
							{{ (diff / 3600)|round }}
							h
						{% elseif diff < 2592000 %}
							il y a
							{{ (diff / 86400)|round }}
							jours
						{% else %}
							{{ article.createdAt|date('d/m/Y') }}
						{% endif %}
					</span>
				{% endif %}


				{# LIGNE VERTICALE #}
				<div class="divider-vertical"></div>

				<div class="card-actions">


					<span class="icon-wrap">
						<form method="POST" action="{{ path('article_publication_toggle_favorite', {id: article.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('favorite_' ~ article.id) }}">
      {% set isFavori = currentUser ? (userFavoris[article.id]|default(false)) : (favoriCounts[article.id]|default(0) > 0) %}
        <button class="icon-wrap btn-favorite {{ isFavori ? 'favori-active' : 'favori-inactive' }}" type="submit">
        <svg viewbox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
        </svg>
        <span>{{ favoriCounts[article.id]|default(0) }}</span>
             </button>
                  </form>

						{# VUES (STATIC POUR L’INSTANT) #}
						<div class="action-btn">
							<a href="{{ path('article_gigs', { id: article.id }) }}" class="btn btn-view-gigs">

								<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
									<circle cx="12" cy="12" r="3"></circle>
								</svg>
							</a>
						</div>

						<button class="btn btn-comments" onclick="toggleComments({{ article.id }})">
                <svg class="icon" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                 </svg>
                 {{ commentCounts[article.id]|default(0) }}
              </button>
					</span>

				</div>
			</div>


			<div id="comments-{{ article.id }}" class="comments-section" style="display: none;">
				<div class="comments-card">
					
					<div class="comments-list">
						{% for comment in commentsByArticle[article.id] %}
							<div
								class="comment-item" id="comment-{{ comment.id }}">

								{# 🔹 Ligne 1 : Nom + Date #}
								<div class="comment-top">
									<span class="comment-author">
										{{ comment.user ? comment.user.firstName : 'Anonyme' }}
										{{ comment.user ? comment.user.lastName : '' }}
									</span>

									<span class="comment-date">
										{% set now = "now"|date("U") %}
										{% set created = comment.createdAt|date("U") %}
										{% set diff = now - created %}

										{% if diff < 60 %}
											il y a
											{{ diff }}
											sec
										{% elseif diff < 3600 %}
											il y a
											{{ (diff / 60)|round }}
											min
										{% elseif diff < 86400 %}
											il y a
											{{ (diff / 3600)|round }}
											h
										{% else %}
											il y a
											{{ (diff / 86400)|round }}
											jours
										{% endif %}
									</span>
								</div>

								{# 🔹 Ligne 2 : contenu + icônes #}
								<div class="comment-bottom">
									<p class="comment-content">{{ comment.content }}</p>

									<div
										class="comment-icons">

									{% if currentUser and comment.user and comment.user.id == currentUser.id %}
										{# 🔹 Modifier #}
										<button onclick="toggleEdit({{ comment.id }})" class="icon-btn">
											<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M12 20h9"></path>
												<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
											</svg>
										</button>
									{% endif %}

										{# 🔹 Traduire #}
										<button onclick="translateComment({{ comment.id }}, 'ar')" class="icon-btn translate-btn" title="Traduire en Arabe">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M5 8l6 6"></path>
												<path d="M4 14l6-6 2-3"></path>
												<path d="M22 5l-7 13-3-8h5"></path>
											</svg>
										</button>

									{% if currentUser and comment.user and comment.user.id == currentUser.id %}
										{# 🔹 Supprimer #}
										<form method="POST" action="{{ path('article_publication_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Supprimer ?')">

											<input type="hidden" name="_token" value="{{ csrf_token('comment_delete_' ~ comment.id) }}">

											<button type="submit" class="icon-btn delete">
												<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<polyline points="3 6 5 6 21 6"></polyline>
													<path d="M19 6l-1 14H6L5 6"></path>
													<path d="M10 11v6"></path>
													<path d="M14 11v6"></path>
													<path d="M9 6V4h6v2"></path>
												</svg>
											</button>
										</form>
									{% endif %}

									</div>
								</div>

								{# 🔹 Zone édition cachée #}
								<div class="edit-zone" id="edit-zone-{{ comment.id }}">
									<form method="POST" action="{{ path('article_publication_comment_edit', { id: comment.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('comment_edit_' ~ comment.id) }}">
              <textarea name="content">{{ comment.content }}</textarea>
                   <button type="submit" class="btn btn-edit">Modifier</button>
             </form>
								</div>

							</div>
						{% endfor %}
					</div>
					<h5>Ajouter un commentaire</h5>
					<form method="POST" action="{{ path('article_publication_comment_add', {id: article.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('comment_add_' ~ article.id) }}">
						<textarea id="comment-textarea-{{ article.id }}" name="content" placeholder="Écrivez votre commentaire ici..." required></textarea>
						
						<div class="comment-form-actions">
							<button class="btn btn-add">Ajouter</button>
							<button type="button" class="btn btn-ai-suggest" onclick="loadAiSuggestions({{ article.id }})">
								✨ Inspirer avec l'IA
							</button>
						</div>

						<div id="ai-suggestions-{{ article.id }}" class="ai-suggestions-container" style="display: none;"></div>
					</form>
				</div>
			</div>


		</div>
	{% else %}
		<p>Aucun article visible.</p>
	{% endfor %}
	<div class="pagination">
		{{ knp_pagination_render(pagination) }}
	</div>
</div>
<script>
	function toggleComments(articleId) {
const commentsSection = document.getElementById(`comments-${articleId}`);
if (commentsSection.style.display === 'none') {
commentsSection.style.display = 'block';
} else {
commentsSection.style.display = 'none';
}
}
function toggleEdit(commentId) {
    const zone = document.getElementById("edit-zone-" + commentId);
    zone.style.display = (zone.style.display === "block") ? "none" : "block";
}

// 🎤 Web Speech API - Voice Search
const voiceBtn = document.getElementById('voice-btn');
const searchInput = document.getElementById('search-q');

if ('webkitSpeechRecognition' in window) {
    const recognition = new webkitSpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.lang = 'fr-FR';

    voiceBtn.addEventListener('click', () => {
        voiceBtn.classList.add('recording');
        recognition.start();
    });

    recognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript;
        searchInput.value = transcript;
        voiceBtn.classList.remove('recording');
        document.getElementById('search-form').submit();
    };

    recognition.onerror = () => {
        voiceBtn.classList.remove('recording');
        alert("Erreur de reconnaissance vocale.");
    };

    recognition.onend = () => {
        voiceBtn.classList.remove('recording');
    };
} else {
    voiceBtn.style.display = 'none';
}

// 🌐 Comment Translation (MyMemory)
function translateComment(commentId, lang) {
    const commentEl = document.querySelector(`#comment-${commentId} .comment-content`);
    const originalText = commentEl.innerText;
    
    commentEl.innerText = "Traduction en cours...";
    
    fetch(`/publications/comments/${commentId}/translate/${lang}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                commentEl.innerHTML = `<strong>(Traduit)</strong> ${data.translatedContent}`;
            } else {
                commentEl.innerText = originalText;
                alert("Erreur lors de la traduction.");
            }
        })
        .catch(() => {
            commentEl.innerText = originalText;
            alert("Erreur réseau.");
        });
}

// ✨ AI Comment Suggestions
function loadAiSuggestions(articleId) {
    const container = document.getElementById(`ai-suggestions-${articleId}`);
    const textarea = document.getElementById(`comment-textarea-${articleId}`);
    
    if (!textarea) {
        console.error("Textarea non trouvé pour l'ID", articleId);
        return;
    }

    const context = textarea.value.trim();

    container.innerHTML = '<p style="font-size: 13px; color: #7c3aed; padding: 10px;">✨ Génération de 3 suggestions en cours...</p>';
    container.style.display = 'block';

    fetch(`/articles/article/${articleId}/suggest-comments?context=${encodeURIComponent(context)}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                container.innerHTML = '<p style="font-size: 12px; color: #6b7280; margin-bottom: 10px; padding-left: 5px;">Cliquez sur une suggestion pour l\'utiliser :</p>';
                data.suggestions.forEach(suggestion => {
                    const item = document.createElement('div');
                    item.className = 'ai-suggestion-item';
                    item.innerText = suggestion;
                    item.onclick = () => {
                        textarea.value = suggestion;
                        textarea.focus();
                        // Petit effet visuel pour confirmer le changement
                        textarea.style.borderColor = '#7c3aed';
                        textarea.style.backgroundColor = '#f5f3ff';
                        setTimeout(() => {
                            textarea.style.borderColor = '';
                            textarea.style.backgroundColor = '';
                        }, 500);
                    };
                    container.appendChild(item);
                });
            } else {
                container.innerHTML = '<p style="font-size: 13px; color: #ef4444; padding: 10px;">Erreur: ' + data.error + '</p>';
            }
        })
        .catch(() => {
            container.innerHTML = '<p style="font-size: 13px; color: #ef4444; padding: 10px;">Erreur réseau.</p>';
        });
}
</script>

								  
