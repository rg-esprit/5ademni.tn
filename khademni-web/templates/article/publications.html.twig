{% extends 'base.html.twig' %}

{% block title %}Articles
{% endblock %}

{% block body %}
<div class="page">
	<div class="filter-buttons">
		<h1>Articles</h1>
		<div class="filters">
			<a class="btn filter-btn {{ sort == 'favoris' ? 'active' : '' }}" href="{{ path('article_publications', {sort: 'favoris'}) }}">
				<div class="icon-wrap">
					<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
					</svg>
				</div>
				Tri Favoris
			</a>
			<a class="btn filter-btn {{ sort == 'commentaires' ? 'active' : '' }}" href="{{ path('article_publications', {sort: 'commentaires'}) }}">
				<div class="icon-wrap">
					<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
					</svg>
				</div>
				Tri Commentaires
			</a>
		</div>
	</div>

	{% for article in articles %}
		<div class="card">


			<div class="card-content">


				{% if article.imagePath %}
					{% set filename = article.imagePath|split('\\')|last %}
					<img src="{{ asset('uploads/images/' ~ filename) }}" class="article-image">
				{% endif %}

				{# LIGNE VERTICALE #}
				<div class="divider-vertical"></div>

				<div class="card-main">
					<h3>{{ article.title }}</h3>
					<p class="card-text">{{ article.content }}</p>
				</div>


				{% if article.createdAt %}
					{% set now = "now"|date("U") %}
					{% set created = article.createdAt|date("U") %}
					{% set diff = now - created %}

					<span class="time-ago">
						{% if diff < 60 %}
							il y a
							{{ diff }}
							sec
						{% elseif diff < 3600 %}
							il y a
							{{ (diff / 60)|round }}
							min
						{% elseif diff < 86400 %}
							il y a
							{{ (diff / 3600)|round }}
							h
						{% elseif diff < 2592000 %}
							il y a
							{{ (diff / 86400)|round }}
							jours
						{% else %}
							{{ article.createdAt|date('d/m/Y') }}
						{% endif %}
					</span>
				{% endif %}


				{# LIGNE VERTICALE #}
				<div class="divider-vertical"></div>

				<div class="card-actions">


					<span class="icon-wrap">
						<form method="POST" action="{{ path('article_publication_toggle_favorite', {id: article.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('favorite_' ~ article.id) }}">
    {% set isFavori = currentUser ? (userFavoris[article.id]|default(false)) : (favoriCounts[article.id]|default(0) > 0) %}
    <button class="icon-wrap btn-favorite {{ isFavori ? 'favori-active' : 'favori-inactive' }}" type="submit">
        <svg viewbox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
        </svg>
        <span>{{ favoriCounts[article.id]|default(0) }}</span>
    </button>
</form>

						{# VUES (STATIC POUR L’INSTANT) #}
						<div class="action-btn">
							<a href="{{ path('article_gigs', { id: article.id }) }}" class="btn btn-view-gigs">

								<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
									<circle cx="12" cy="12" r="3"></circle>
								</svg>
							</a>
						</div>

						<button class="btn btn-comments" onclick="toggleComments({{ article.id }})">
    <svg class="icon" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    {{ commentCounts[article.id]|default(0) }}
</button>
					</span>

				</div>
			</div>


			<div id="comments-{{ article.id }}" class="comments-section" style="display: none;">
				<div class="comments-card">
					
					<div class="comments-list">
						{% for comment in commentsByArticle[article.id] %}
							<div
								class="comment-item" id="comment-{{ comment.id }}">

								{# 🔹 Ligne 1 : Nom + Date #}
								<div class="comment-top">
									<span class="comment-author">
										{{ comment.user ? comment.user.firstName : 'Anonyme' }}
										{{ comment.user ? comment.user.lastName : '' }}
									</span>

									<span class="comment-date">
										{% set now = "now"|date("U") %}
										{% set created = comment.createdAt|date("U") %}
										{% set diff = now - created %}

										{% if diff < 60 %}
											il y a
											{{ diff }}
											sec
										{% elseif diff < 3600 %}
											il y a
											{{ (diff / 60)|round }}
											min
										{% elseif diff < 86400 %}
											il y a
											{{ (diff / 3600)|round }}
											h
										{% else %}
											il y a
											{{ (diff / 86400)|round }}
											jours
										{% endif %}
									</span>
								</div>

								{# 🔹 Ligne 2 : contenu + icônes #}
								<div class="comment-bottom">
									<p class="comment-content">{{ comment.content }}</p>

									<div
										class="comment-icons">

										{# 🔹 Modifier #}
										<button onclick="toggleEdit({{ comment.id }})" class="icon-btn">
											<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M12 20h9"></path>
												<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
											</svg>
										</button>

										{# 🔹 Supprimer #}
										<form method="POST" action="{{ path('article_publication_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Supprimer ?')">

											<input type="hidden" name="_token" value="{{ csrf_token('comment_delete_' ~ comment.id) }}">

											<button type="submit" class="icon-btn delete">
												<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<polyline points="3 6 5 6 21 6"></polyline>
													<path d="M19 6l-1 14H6L5 6"></path>
													<path d="M10 11v6"></path>
													<path d="M14 11v6"></path>
													<path d="M9 6V4h6v2"></path>
												</svg>
											</button>
										</form>

									</div>
								</div>

								{# 🔹 Zone édition cachée #}
								<div class="edit-zone" id="edit-zone-{{ comment.id }}">
									<form method="POST" action="{{ path('article_publication_comment_edit', { id: comment.id }) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('comment_edit_' ~ comment.id) }}">
    <textarea name="content">{{ comment.content }}</textarea>
    <button type="submit" class="btn btn-edit">Modifier</button>
</form>
								</div>

							</div>
						{% endfor %}
					</div>
					<h5>Ajouter un commentaire</h5>
					<form method="POST" action="{{ path('article_publication_comment_add', {id: article.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('comment_add_' ~ article.id) }}">
						<textarea name="content" placeholder="Écrivez votre commentaire ici..." required></textarea>
						<button class="btn btn-add">Ajouter</button>
					</form>
				</div>
			</div>


		</div>
	{% else %}
		<p>Aucun article visible.</p>
	{% endfor %}
</div>
<script>
	function toggleComments(articleId) {
const commentsSection = document.getElementById(`comments-${articleId}`);
if (commentsSection.style.display === 'none') {
commentsSection.style.display = 'block';
} else {
commentsSection.style.display = 'none';
}
}
function toggleEdit(commentId) {
const zone = document.getElementById("edit-zone-" + commentId);

if (zone.style.display === "block") {
zone.style.display = "none";
} else {
zone.style.display = "block";
}
}
</script>

								  
