{% extends 'base.html.twig' %}

{% block title %}Articles | 5ademni.tn{% endblock %}

{% block body %}
<style>
    .article-shell {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .article-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: end;
        padding: 2rem;
        background: linear-gradient(135deg, #f5f3ff 0%, #eef2ff 100%);
        border: 1px solid #ddd6fe;
        border-radius: 1.25rem;
    }

    .article-hero h1 {
        margin: 0.25rem 0 0.5rem;
        font-size: clamp(2rem, 4vw, 2.8rem);
    }

    .article-hero p {
        margin: 0;
        color: #5b6475;
        max-width: 60ch;
    }

    .article-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        justify-content: flex-end;
    }

    .article-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1rem;
        border-radius: 999px;
        border: 1px solid #d8d4fe;
        background: rgba(255, 255, 255, 0.85);
        color: #4338ca;
        font-weight: 700;
        text-decoration: none;
    }

    .article-filter.active {
        background: #4f46e5;
        border-color: #4f46e5;
        color: #fff;
    }

    .article-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .article-card {
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 1.1rem;
        background: #fff;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .article-card-top {
        display: grid;
        grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
        gap: 1.25rem;
        padding: 1.25rem;
    }

    .article-card-image {
        width: 100%;
        height: 220px;
        border-radius: 0.9rem;
        object-fit: cover;
        background: linear-gradient(135deg, #ddd6fe, #e0e7ff);
    }

    .article-card-copy {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 0;
    }

    .article-card-copy h2 {
        margin: 0;
        font-size: 1.5rem;
        line-height: 1.2;
    }

    .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        color: #667085;
        font-size: 0.9rem;
    }

    .article-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        background: #eef2ff;
        color: #4338ca;
        font-weight: 700;
        font-size: 0.82rem;
    }

    .article-content {
        margin: 0;
        color: #344054;
        line-height: 1.75;
        white-space: pre-wrap;
    }

    .article-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }

    .article-inline-form {
        margin: 0;
    }

    .article-button,
    .article-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.72rem 1rem;
        border-radius: 0.85rem;
        border: 1px solid #d0d5dd;
        background: #fff;
        color: #344054;
        text-decoration: none;
        font-weight: 700;
        cursor: pointer;
    }

    .article-button.is-active {
        border-color: #ec4899;
        background: #fff1f7;
        color: #be185d;
    }

    .article-link.primary {
        border-color: #c7d2fe;
        background: #eef2ff;
        color: #3730a3;
    }

    .article-comments {
        border-top: 1px solid #eef2f6;
        padding: 1rem 1.25rem 1.25rem;
    }

    .article-comments summary {
        cursor: pointer;
        font-weight: 800;
        color: #1f2937;
        list-style: none;
    }

    .article-comments summary::-webkit-details-marker {
        display: none;
    }

    .comment-stack {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        margin-top: 1rem;
    }

    .comment-card {
        border: 1px solid #eaecf0;
        border-radius: 0.9rem;
        padding: 1rem;
        background: #fcfcfd;
    }

    .comment-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.65rem;
        color: #667085;
        font-size: 0.88rem;
    }

    .comment-card p {
        margin: 0;
        color: #344054;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .comment-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 0.9rem;
    }

    .comment-actions form,
    .comment-actions details {
        margin: 0;
    }

    .comment-actions details {
        flex: 1 1 100%;
    }

    .comment-actions details summary {
        cursor: pointer;
        color: #4f46e5;
        font-weight: 700;
    }

    .comment-edit-form,
    .comment-create-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .comment-textarea {
        width: 100%;
        min-height: 120px;
        padding: 0.9rem 1rem;
        border: 1px solid #d0d5dd;
        border-radius: 0.9rem;
        resize: vertical;
        font: inherit;
        background: #fff;
    }

    .comment-submit {
        align-self: flex-start;
        padding: 0.75rem 1.1rem;
        border: none;
        border-radius: 0.85rem;
        background: #4f46e5;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

    .pagination {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    .page-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.75rem;
        padding: 0.7rem 0.95rem;
        border: 1px solid #d0d5dd;
        border-radius: 0.8rem;
        background: #fff;
        color: #475467;
        text-decoration: none;
        font-weight: 700;
    }

    .page-link.active {
        background: #4f46e5;
        border-color: #4f46e5;
        color: #fff;
    }

    .empty-panel {
        padding: 2.5rem;
        border: 1px dashed #c7d2fe;
        border-radius: 1rem;
        text-align: center;
        background: #f8faff;
        color: #475467;
    }

    @media (max-width: 900px) {
        .article-hero,
        .article-card-top {
            grid-template-columns: 1fr;
        }

        .article-hero-actions {
            justify-content: flex-start;
        }

        .article-card-image {
            height: 200px;
        }
    }
</style>

<div class="page-shell">
    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <div class="article-shell">
            <section class="article-hero">
                <div>
                    <p class="eyebrow">Articles</p>
                    <h1>Community articles worth reading</h1>
                    <p>Browse the public article feed, react to posts, open matching gigs, and jump into the comment threads without leaving the shared site shell.</p>
                </div>
                <div class="article-hero-actions">
                    <a class="article-filter {{ sort == 'favoris' ? 'active' : '' }}" href="{{ path('article_publications', {sort: 'favoris'}) }}">Most liked</a>
                    <a class="article-filter {{ sort == 'commentaires' ? 'active' : '' }}" href="{{ path('article_publications', {sort: 'commentaires'}) }}">Most discussed</a>
                    <a class="article-filter" href="{{ path('article_blogs') }}">Blogs overview</a>
                </div>
            </section>

            {% if articles is empty %}
                <section class="empty-panel">
                    <h2 style="margin-top:0;">No visible articles yet</h2>
                    <p style="margin-bottom:0;">Published articles will appear here once the content team adds them.</p>
                </section>
            {% else %}
                <div class="article-list">
                    {% for article in articles %}
                        {% set imageName = article.imagePath ? article.imagePath|split('/')|last : null %}
                        {% set comments = commentsByArticle[article.id]|default([]) %}
                        {% set isFavori = currentUser ? (userFavoris[article.id]|default(false)) : (favoriCounts[article.id]|default(0) > 0) %}
                        <article id="article-{{ article.id }}" class="article-card">
                            <div class="article-card-top">
                                {% if imageName %}
                                    <img src="{{ asset('uploads/images/' ~ imageName) }}" alt="{{ article.title }}" class="article-card-image">
                                {% else %}
                                    <div class="article-card-image" aria-hidden="true"></div>
                                {% endif %}

                                <div class="article-card-copy">
                                    <div class="article-meta">
                                        <span class="article-pill">{{ article.createdAt ? article.createdAt|date('d M Y') : 'Draft' }}</span>
                                        <span>{{ favoriCounts[article.id]|default(0) }} favorites</span>
                                        <span>{{ commentCounts[article.id]|default(0) }} comments</span>
                                    </div>

                                    <h2>{{ article.title }}</h2>
                                    <p class="article-content">{{ article.content }}</p>

                                    <div class="article-actions">
                                        <form method="POST" action="{{ path('article_publication_toggle_favorite', {id: article.id}) }}" class="article-inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('favorite_' ~ article.id) }}">
                                            <button class="article-button {{ isFavori ? 'is-active' : '' }}" type="submit">{{ isFavori ? '♥' : '♡' }} {{ favoriCounts[article.id]|default(0) }}</button>
                                        </form>

                                        <a class="article-link primary" href="{{ path('article_gigs', {id: article.id}) }}">Related gigs</a>
                                    </div>
                                </div>
                            </div>

                            <details class="article-comments">
                                <summary>Comments ({{ commentCounts[article.id]|default(0) }})</summary>

                                <div class="comment-stack">
                                    {% for comment in comments %}
                                        <article class="comment-card">
                                            <div class="comment-head">
                                                <strong>{{ comment.user ? comment.user.firstName ~ ' ' ~ comment.user.lastName : 'Anonyme' }}</strong>
                                                <span>{{ comment.createdAt ? comment.createdAt|date('d M Y H:i') : '' }}</span>
                                            </div>
                                            <p>{{ comment.content }}</p>

                                            <div class="comment-actions">
                                                <details>
                                                    <summary>Edit comment</summary>
                                                    <form method="POST" action="{{ path('article_publication_comment_edit', {id: comment.id}) }}" class="comment-edit-form">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('comment_edit_' ~ comment.id) }}">
                                                        <textarea name="content" class="comment-textarea">{{ comment.content }}</textarea>
                                                        <button type="submit" class="comment-submit">Save changes</button>
                                                    </form>
                                                </details>

                                                <form method="POST" action="{{ path('article_publication_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Delete this comment?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('comment_delete_' ~ comment.id) }}">
                                                    <button type="submit" class="article-button">Delete</button>
                                                </form>
                                            </div>
                                        </article>
                                    {% else %}
                                        <div class="comment-card">
                                            <p>No comments yet. Be the first to react.</p>
                                        </div>
                                    {% endfor %}
                                </div>

                                <form method="POST" action="{{ path('article_publication_comment_add', {id: article.id}) }}" class="comment-create-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('comment_add_' ~ article.id) }}">
                                    <textarea name="content" class="comment-textarea" placeholder="Share your thoughts about this article..." required></textarea>
                                    <button class="comment-submit" type="submit">Add comment</button>
                                </form>
                            </details>
                        </article>
                    {% endfor %}
                </div>

                <nav class="pagination" aria-label="Articles pagination">
                    {% if pagination.hasPreviousPage %}
                        <a href="{{ path('article_publications', {page: pagination.previousPage, sort: sort}) }}" class="page-link">Previous</a>
                    {% endif %}

                    {% for page in 1..pagination.nbPages %}
                        <a href="{{ path('article_publications', {page: page, sort: sort}) }}" class="page-link {{ page == pagination.currentPage ? 'active' : '' }}">{{ page }}</a>
                    {% endfor %}

                    {% if pagination.hasNextPage %}
                        <a href="{{ path('article_publications', {page: pagination.nextPage, sort: sort}) }}" class="page-link">Next</a>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
