{% extends 'base.html.twig' %}

{% block title %}Blogs | 5ademni.tn{% endblock %}

{% block body %}
<style>
    .blog-shell {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .blog-hero {
        padding: 2rem;
        border-radius: 1.25rem;
        background: radial-gradient(circle at top left, #ede9fe, #f8fafc 58%);
        border: 1px solid #ddd6fe;
    }

    .blog-hero h1 {
        margin: 0.25rem 0 0.75rem;
        font-size: clamp(2rem, 4vw, 3rem);
    }

    .blog-hero p {
        margin: 0;
        max-width: 62ch;
        color: #5b6475;
        line-height: 1.7;
    }

    .blog-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.25rem;
    }

    .blog-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.1rem;
        border-radius: 0.9rem;
        text-decoration: none;
        font-weight: 700;
        border: 1px solid #c7d2fe;
        background: #eef2ff;
        color: #3730a3;
    }

    .blog-action.secondary {
        border-color: #d0d5dd;
        background: #fff;
        color: #344054;
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .blog-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .blog-card-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
        background: linear-gradient(135deg, #ddd6fe, #e0e7ff);
    }

    .blog-card-body {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        padding: 1.1rem 1.1rem 1.25rem;
        height: 100%;
    }

    .blog-card-body h2 {
        margin: 0;
        font-size: 1.3rem;
        line-height: 1.3;
    }

    .blog-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        color: #667085;
        font-size: 0.88rem;
    }

    .blog-excerpt {
        margin: 0;
        color: #475467;
        line-height: 1.7;
    }

    .blog-card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: auto;
    }

    .blog-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 0.95rem;
        border-radius: 0.8rem;
        border: 1px solid #d0d5dd;
        background: #fff;
        color: #344054;
        font-weight: 700;
        text-decoration: none;
    }

    .blog-link.primary {
        border-color: #c7d2fe;
        background: #eef2ff;
        color: #3730a3;
    }

    .empty-panel {
        padding: 2.5rem;
        border: 1px dashed #c7d2fe;
        border-radius: 1rem;
        text-align: center;
        background: #f8faff;
        color: #475467;
    }

    @media (max-width: 1100px) {
        .blog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 720px) {
        .blog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-shell">
    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <div class="blog-shell">
            <section class="blog-hero">
                <p class="eyebrow">Blogs</p>
                <h1>Fresh stories from the 5ademni community</h1>
                <p>This space highlights the latest visible posts in a cleaner editorial layout. When you want reactions, comments, and article interactions, jump into the full articles feed.</p>
                <div class="blog-hero-actions">
                    <a class="blog-action" href="{{ path('article_publications') }}">Open articles feed</a>
                    <a class="blog-action secondary" href="{{ path('article_publications', {sort: 'commentaires'}) }}">Most discussed posts</a>
                </div>
            </section>

            {% if articles is empty %}
                <section class="empty-panel">
                    <h2 style="margin-top:0;">No blog posts yet</h2>
                    <p style="margin-bottom:0;">Visible articles will automatically appear here as soon as they are published.</p>
                </section>
            {% else %}
                <section class="blog-grid">
                    {% for article in articles %}
                        {% set imageName = article.imagePath ? article.imagePath|split('/')|last : null %}
                        <article class="blog-card">
                            {% if imageName %}
                                <img src="{{ asset('uploads/images/' ~ imageName) }}" alt="{{ article.title }}" class="blog-card-image">
                            {% else %}
                                <div class="blog-card-image" aria-hidden="true"></div>
                            {% endif %}

                            <div class="blog-card-body">
                                <div class="blog-meta">
                                    <span>{{ article.createdAt ? article.createdAt|date('d M Y') : 'Draft' }}</span>
                                    <span>{{ favoriCounts[article.id]|default(0) }} favorites</span>
                                    <span>{{ commentCounts[article.id]|default(0) }} comments</span>
                                </div>

                                <h2>{{ article.title }}</h2>
                                <p class="blog-excerpt">
                                    {{ article.content|slice(0, 180) }}{% if article.content|length > 180 %}...{% endif %}
                                </p>

                                <div class="blog-card-actions">
                                    <a class="blog-link primary" href="{{ path('article_publications') ~ '#article-' ~ article.id }}">Read article</a>
                                    <a class="blog-link" href="{{ path('article_gigs', {id: article.id}) }}">Related gigs</a>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </section>
            {% endif %}
        </div>
    </main>
</div>

{% endblock %}


