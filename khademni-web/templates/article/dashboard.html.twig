{% extends 'base.html.twig' %}

{% block title %}Dashboard Articles
{% endblock %}

{% block stylesheets %}
	<style>
		.page-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 20px;
		}
		.page-header h1 {
			margin: 0
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 16px;
			margin-bottom: 20px;
		}

		.card {
			background: #fff;
			border: 1px solid #ece7fb;
			border-radius: 16px;
			box-shadow: 0 8px 24px rgba(124, 58, 237, 0.08);
			padding: 20px;
			position: relative;
			overflow: hidden;
		}
		canvas {padding: 30px;
    max-width: 1300px; /* Largeur maximale */
    max-height: 500px; /* Hauteur maximale */
}
		.card::before {
			content: '';
			position: absolute;
			top: -20px;
			right: -20px;
			width: 80px;
			height: 80px;
			border-radius: 50%;
			opacity: .1;
		}
		.card.blue::before {
			background: #3b82f6
		}
		.card.yellow::before {
			background: #fbbf24
		}
		.card.purple::before {
			background: #a78bfa
		}
		.card.pink::before {
			background: #f472b6
		}

		.card-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			margin-bottom: 12px;
		}
		.card-content {
			flex: 1
		}
		.card-icon {
			width: 50px;
			height: 50px;
			border-radius: 12px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 24px;
			flex-shrink: 0;
		}
		.card.blue .card-icon {
			background: #dbeafe;
			color: #0284c7
		}
		.card.yellow .card-icon {
			background: #fef3c7;
			color: #d97706
		}
		.card.purple .card-icon {
			background: #ede9fe;
			color: #7c3aed
		}
		.card.pink .card-icon {
			background: #fbecf8;
			color: #db2777
		}

		.card h3 {
			margin: 0 0 4px;
			color: #7e739a;
			font-size: 13px;
			font-weight: 500;
		}
		.stat {
			font-size: 32px;
			font-weight: 700;
			color: #2c2240;
			margin-bottom: 8px;
		}

		.card-trend {
			font-size: 12px;
			font-weight: 600;
		}
		.card-trend.up {
			color: #059669
		}
		.card-trend.down {
			color: #dc2626
		}

		.panel {
			background: #fff;
			border: 1px solid #ece7fb;
			border-radius: 16px;
			box-shadow: 0 6px 20px rgba(124, 58, 237, 0.08);
			padding: 10px;
			margin-bottom: 10px;
		}

		.charts {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 16px;
		}
		.charts .panel:last-child {
			grid-column: 1/-1;
		}

		.btn {
			border: none;
			border-radius: 10px;
			padding: 10px 16px;
			cursor: pointer;
			font-weight: 600;
			font-size: 14px;
		}
		.btn-primary {
			background: #7c3aed;
			color: #fff;
		}
		.btn-primary:hover {
			background: #6d28d9;
		}

		/* Modal */
		.modal {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.5);
			z-index: 2000;
			align-items: center;
			justify-content: center;
		}
		.modal.show {
			display: flex;
		}
		.modal-content {
			background: #fff;
			border-radius: 16px;
			padding: 28px;
			width: 90%;
			max-width: 600px;
			max-height: 90vh;
			overflow: auto;
			box-shadow: 0 20px 60px rgba(124, 58, 237, 0.2);
		}
		.modal-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 20px;
		}
		.modal-header h2 {
			margin: 0;
			color: #2c2240
		}
		.modal-close {
			background: none;
			border: none;
			font-size: 24px;
			cursor: pointer;
			color: #7e739a;
		}

		.form-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 12px;
		}
		input,
		textarea,
		select {
			width: 100%;
			padding: 10px 12px;
			border-radius: 10px;
			border: 1px solid #e7defd;
			background: #faf8ff;
			color: #2c2240;
			font-family: inherit;
		}
		input:focus,
		textarea:focus,
		select:focus {
			outline: none;
			border-color: #7c3aed;
			background: #fff;
		}
		textarea {
			min-height: 100px;
			grid-column: 1/-1;
			resize: vertical;
		}

		.form-actions {
			margin-top: 20px;
			display: flex;
			gap: 10px;
		}
		.btn-cancel {
			background: #e7defd;
			color: #4b2ca3;
			border: none;
		}
		.btn-cancel:hover {
			background: #dcc9ff;
		}
		.btn-add {
			display: flex;
			align-items: center;
			gap: 10px;

			background: linear-gradient(135deg, #7c3aed, #a78bfa);
			color: white;

			border: none;
			border-radius: 12px;
			padding: 12px 18px;

			font-weight: 600;
			font-size: 14px;

			cursor: pointer;
			box-shadow: 0 10px 25px rgba(124, 58, 237, 0.3);

			transition: all 0.3s ease;
			position: relative;
			overflow: hidden;
		}

		/* ICON */
		.btn-add .icon {
			font-size: 18px;
			transition: transform 0.3s ease;
		}

		/* HOVER EFFECT */
		.btn-add:hover {
			transform: translateY(-3px) scale(1.03);
			box-shadow: 0 15px 35px rgba(124, 58, 237, 0.45);
		}

		/* ICON ROTATION */
		.btn-add:hover .icon {
			transform: rotate(90deg);
		}

		/* CLICK EFFECT */
		.btn-add:active {
			transform: scale(0.95);
		}

		/* GLOW ANIMATION */
		.btn-add::after {
			content: '';
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: linear-gradient(120deg,transparent,rgba(255,255,255,.4),transparent);
			transition: 0.5s;
		}

		.page-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 20px;
		}

		.header-actions {
			display: flex;
			align-items: center;
			gap: 20px;
		}

		.filter {
			display: flex;
			align-items: center;
			gap: 10px;
			margin: 0;
		}

		.filter label {
			font-weight: 600;
			color: #2c2240;
		}

		.filter select {
			padding: 8px 12px;
			border-radius: 8px;
			border: 1px solid #e7defd;
			background: #faf8ff;
			color: #2c2240;
			font-size: 14px;
			font-weight: 500;
			transition: all 0.3s ease;
		}

		.filter select:hover {
			border-color: #7c3aed;
			background: #fff;
		}

		.filter select:focus {
			outline: none;
			border-color: #7c3aed;
			box-shadow: 0 0 5px rgba(124, 58, 237, 0.5);
		}

		.filter select option {
			font-size: 14px;
			font-weight: 500;
		}

		.btn-add {
			display: flex;
			align-items: center;
			gap: 10px;
			background: linear-gradient(135deg, #7c3aed, #a78bfa);
			color: white;
			border: none;
			border-radius: 12px;
			padding: 12px 18px;
			font-weight: 600;
			font-size: 14px;
			cursor: pointer;
			box-shadow: 0 10px 25px rgba(124, 58, 237, 0.3);
			transition: all 0.3s ease;
			position: relative;
			overflow: hidden;
		}

		.btn-add:hover {
			transform: translateY(-3px) scale(1.03);
			box-shadow: 0 15px 35px rgba(124, 58, 237, 0.45);
		}
		@media(max-width: 1200px) {
			.grid {
				grid-template-columns: repeat(2, 1fr)
			}
			.charts {
				grid-template-columns: 1fr
			}
			.charts .panel:last-child {
				grid-column: auto
			}
		}

		@media(max-width: 768px) {
			.grid {
				grid-template-columns: 1fr
			}

			.modal-content {
				width: 95%;
				padding: 20px
			}
			.form-grid {
				grid-template-columns: 1fr
			}
			textarea {
				grid-column: auto
			}
		}


		.progress-circle {
			--size: 70px;
			--thickness: 6px;
			--value: 0;

			width: var(--size);
			height: var(--size);
			border-radius: 50%;

			display: flex;
			align-items: center;
			justify-content: center;

			font-weight: 700;
			font-size: 14px;
			color: #2c2240;

			position: relative;
			background: conic-gradient(#7c3aed calc(var(--value) * 1%), #eee 0);
		}

		/* cercle interne */
		.progress-circle::before {
			content: "";
			position: absolute;
			width: calc(var(--size) - var(--thickness) * 2);
			height: calc(var(--size) - var(--thickness) * 2);
			background: #fff;
			border-radius: 50%;
		}

		/* texte */
		.progress-circle span {
			position: relative;
			z-index: 1;
		}

		/* couleurs dynamique */
		.progress-circle.up {
			background: conic-gradient(#10b981 calc(var(--value) * 1%), #eee 0);
		}

		.progress-circle.down {
			background: conic-gradient(#ef4444 calc(var(--value) * 1%), #eee 0);
		}
		.progress-circle {
			animation: grow 1s ease-out forwards;
		}

		@keyframes grow {
			from {
				--value: 0;
			}
		}
	</style>
{% endblock %}

{% block body %}
	<div class="page-shell">
		{% include 'partials/_header.html.twig' %}

		<main class="page-content">
	<div class="page">
		<div class="page-header">
			<h1>Dashboard Articles</h1>
			<div class="header-actions">
				<a href="{{ path('article_new') }}" class="btn-add">
					<span class="icon">＋</span>
					<span>Ajouter</span>
				</a>
				<form method="GET" action="{{ path('article_dashboard') }}" class="filter">
					<label for="period">Filtrer les graphes par:</label>
					<select name="period" id="period" onchange="this.form.submit()">
						<option value="1" {% if app.request.get('period') == '1' %} selected {% endif %}>1 mois</option>
						<option value="2" {% if app.request.get('period') == '2' %} selected {% endif %}>2 mois</option>
						<option value="12" {% if app.request.get('period') == '12' %} selected {% endif %}>1 an</option>
					</select>
				</form>
			</div>
		</div>

		<div class="grid">
			<div class="card blue">
				<div class="card-header">
					<div class="card-content">
						<h3>Total Articles</h3>
						<div class="stat">{{ rows|length }}</div>
					</div>
					<div class="card-icon">📑</div>
				</div>


				<div class="progress-circle {{ trends.total.class }}" style="--value: {{ trends.total.percent }}">
					<span>{{ trends.total.percent }}%</span>
				</div>

				{# <div class="card-trend {{ trends.total.class }}">
					{{ trends.total.arrow }}
					ce mois vs mois dernier
				</div> #}


			</div>

			<div class="card yellow">
				<div class="card-header">
					<div class="card-content">
						<h3>Articles visibles</h3>
						<div class="stat">{{ statusStats.VISIBLE|default(0) }}</div>
					</div>
					<div class="card-icon">✓</div>
				</div>


				<div class="progress-circle {{ trends.visible.class }}" style="--value: {{ trends.visible.percent }}">
					<span>{{ trends.visible.percent }}%</span>
				</div>

				{# <div class="card-trend {{ trends.visible.class }}">
					{{ trends.visible.arrow }}
					ce mois vs mois dernier
				</div> #}


			</div>

			<div class="card yellow">
				<div class="card-header">
					<div class="card-content">
						<h3>Articles Masqués</h3>
						<div class="stat">{{ statusStats.MASQUE|default(0) }}</div>
					</div>
					<div class="card-icon">✗</div>
				</div>


				<div class="progress-circle {{ trends.hidden.class }}" style="--value: {{ trends.hidden.percent }}">
					<span>{{ trends.hidden.percent }}%</span>
				</div>

				{# <div class="card-trend {{ trends.hidden.class }}">
					{{ trends.hidden.arrow }}
					ce mois vs mois dernier
				</div> #}


			</div>


			<div class="card purple">
				<div class="card-header">
					<div class="card-content">
						<h3>Interactions</h3>
						<div class="stat">{{ statusStats.interactions|default(0) }}</div>
					</div>
					<div class="card-icon">💬</div>
				</div>

				<div class="progress-circle {{ trends.interactions.class }}" style="--value: {{ trends.interactions.percent }}">
					<span>{{ trends.interactions.percent }}%</span>
				</div>

				{# <div class="card-trend {{ trends.interactions.class }}">
					{{ trends.interactions.arrow }}
					ce mois vs mois dernier
				</div> #}
			</div>

		</div>
	</div>
	<div class="panel">
		<h3 style="margin:0 0 16px 0;color:#2c2240">Activité</h3>

		<canvas id="activityByDate"></canvas>

	</div>
	<div class="charts">
		<div class="panel">
			<h3 style="margin:0 0 16px 0;color:#2c2240">Status des articles</h3>
			<canvas id="statusPie"></canvas>
		</div>
		<div class="panel">
			<h3 style="margin:0 0 16px 0;color:#2c2240">Favoris par article</h3>

			<canvas id="favorisBar"></canvas>
		</div>
		<div class="panel">
			<h3 style="margin:0 0 16px 0;color:#2c2240">Commentaires par article</h3>

			<canvas id="commentairesBar"></canvas>
		</div>
	</div>
</div>

<!-- Modal Ajouter Article -->
<div id="addModal" class="modal">
	<div class="modal-content">
		<div class="modal-header">
			<h2>Ajouter un article</h2>
			<button class="modal-close" type="button" onclick="closeModal()">✕</button>
		</div>
		<form method="post" action="{{ path('article_new') }}">
			<div class="form-grid">
				<input type="text" name="title" placeholder="Titre" required>
				<select name="status" required>
					<option value="VISIBLE">VISIBLE</option>
					<option value="MASQUE">MASQUE</option>
				</select>
				<textarea name="content" placeholder="Contenu de l'article..." required></textarea>
				<input type="text" name="imagePath" placeholder="Chemin image (optionnel)" style="grid-column:1/-1;">
			</div>
			<div class="form-actions">
				<button class="btn btn-primary" type="submit">Ajouter</button>
				<button class="btn btn-cancel" type="button" onclick="closeModal()">Annuler</button>
			</div>
		</form>
	</div>
</div>

<script>
	function openModal() {
document.getElementById('addModal').classList.add('show');
}
function closeModal() {
document.getElementById('addModal').classList.remove('show');
}
window.onclick = (e) => {
const modal = document.getElementById('addModal');
if (e.target === modal) 
closeModal();



};
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
	const labels = {{ chartLabels|json_encode|raw }};
const favorisData = {{ favorisData|json_encode|raw }};
const commentairesData = {{ commentairesData|json_encode|raw }};
const statusVisible = {{ statusStats.VISIBLE|default(0) }};
const statusMasque = {{ statusStats.MASQUE|default(0) }};

const chartConfig = {
responsive: true,
maintainAspectRatio: true,
plugins: {
legend: {
labels: {
color: '#7e739a',
font: {
size: 12
}
}
}
}
};

new Chart(document.getElementById('statusPie'), {
type: 'doughnut',
data: {
labels: [
'VISIBLE', 'MASQUE'
],
datasets: [
{
data: [
statusVisible, statusMasque
],
backgroundColor: [
'#7c3aed', '#f472b6'
],
borderColor: '#fff',
borderWidth: 2
}
]
},
options: chartConfig
});

new Chart(document.getElementById('favorisBar'), {
type: 'bar',
data: {
labels,
datasets: [
{
label: 'Favoris',
data: favorisData,
backgroundColor: '#fbbf24',
borderRadius: 8
}
]
},
options: chartConfig
});

new Chart(document.getElementById('commentairesBar'), {
type: 'line',
data: {
labels,
datasets: [
{
label: 'Commentaires',
data: commentairesData,
borderColor: '#7c3aed',
backgroundColor: 'rgba(124,58,237,.1)',
tension: .35,
fill: true,
borderWidth: 2,
pointBackgroundColor: '#7c3aed',
pointRadius: 4
}
]
},
options: chartConfig
});
const activityLabels = {{ activityLabels|json_encode|raw }};
const articlesByDay = {{ articlesByDay|json_encode|raw }};
const favorisByDay = {{ favorisByDay|json_encode|raw }};
const commentairesByDay = {{ commentairesByDay|json_encode|raw }};

new Chart(document.getElementById('activityByDate'), {
type: 'line',
data: {
labels: activityLabels,
datasets: [
{
label: 'Articles ajoutés',
data: articlesByDay,
borderColor: 'rgba(147, 51, 234, 1)',
backgroundColor: 'rgba(147, 51, 234, 0.2)',
fill: true
}, {
label: 'Favoris ajoutés',
data: favorisByDay,
borderColor: 'rgba(59, 130, 246, 1)',
backgroundColor: 'rgba(59, 130, 246, 0.2)',
fill: true
}, {
label: 'Commentaires ajoutés',
data: commentairesByDay,
borderColor: 'rgba(251, 191, 36, 1)',
backgroundColor: 'rgba(251, 191, 36, 0.2)',
fill: true
},
]
},
options: {
responsive: true,
plugins: {
legend: {
position: 'top'
}
}
}
});
</script>
		</main>
	</div>
{% endblock %}
