<style>
.page {
    margin: 0 auto;
    padding: 30px 40px;
    max-width: 1400px;
}

.cards-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}
.btn-favorite {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.btn-favorite svg {
    fill: #6c0df2; /* Couleur par défaut */
    transition: fill 0.3s ease;
}

.btn-favorite.favori-active svg {
    fill: #ef4444; /* Rouge pour les favoris actifs */
}

.btn-favorite:hover svg {
    transform: scale(1.2);
}
.card-image {
    width: 100%;
    height: 180px; /* même hauteur pour toutes */
    object-fit: cover; /* coupe l'image sans déformation */
    border-radius: 10px;
    margin-bottom: 10px;
}
.card {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 20px;
    width: 300px;
}

.card-header h2 {
    font-size: 18px;
    color: #6c0df2;
}

.card-body p {
    font-size: 14px;
    color: #6b7280;
}

.card-footer {
    text-align: right;
}

.btn-danger {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ef4444;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
    font-weight: 600;
    text-decoration: none;
}

.btn-danger:hover {
    background: #dc2626;
}

.btn-danger svg {
    fill: #fff;
}
</style>
{% endblock %}
