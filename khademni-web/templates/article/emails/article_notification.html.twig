<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ subject }}</title>
</head>
<body>
    <h1>{{ subject }}</h1>
    <p>{{ message }}</p>
    {% if article %}
        <h2>Détails de l'article :</h2>
        <p><strong>Titre :</strong> {{ article.title }}</p>
        <p><strong>Contenu :</strong> {{ article.content }}</p>
    {% endif %}
</body>
</html>