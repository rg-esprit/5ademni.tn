{% extends 'base.html.twig' %}

{% block title %}Work Progress — {{ job.title }} | 5ademni.tn{% endblock %}

{% block body %}
<style>
@keyframes fadeUp  { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
@keyframes barFill { from{width:0} to{width:var(--pct)} }
.au { animation:fadeUp .4s ease both; }

.progress-bar-shell {
    background:#e5e7eb; border-radius:999px; height:14px; overflow:hidden; margin:.6rem 0 .3rem;
}
.progress-bar-fill {
    height:100%; border-radius:999px;
    background:linear-gradient(90deg,#7c3aed,#a78bfa);
    width:0%; transition:width 1.1s cubic-bezier(.4,0,.2,1);
}

.log-card {
    border:1.5px solid #e5e7eb; border-radius:.7rem; padding:1rem 1.2rem;
    background:#fff; animation:fadeUp .35s ease var(--d,0ms) both;
    transition:transform .2s,box-shadow .2s;
}
.log-card:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(0,0,0,.07); }

.pct-badge {
    display:inline-block; padding:.25rem .7rem; border-radius:999px;
    font-size:.85rem; font-weight:800;
    background:linear-gradient(135deg,#ede9fe,#ddd6fe); color:#5b21b6;
}
</style>

<div class="page-shell">
    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <p style="margin-bottom:1rem;" class="au">
            <a href="javascript:history.back()" style="color:#6b7280;text-decoration:none;font-size:.88rem;">← Back</a>
        </p>

        <section class="review-hero au">
            <div>
                <p class="eyebrow">Work Progress{% if is_owner %} · Employer View{% endif %}</p>
                <h1>{{ job.title }}</h1>
                <p class="muted-copy">{{ job.company }} &mdash;
                    {% if is_owner %}
                        Tracking your accepted freelancer's progress.
                    {% else %}
                        Log your progress and keep the client informed.
                    {% endif %}
                </p>
            </div>
            <div class="review-metrics">
                <div class="profile-stat"><span>Completed</span><strong>{{ total_progress }}%</strong></div>
                <div class="profile-stat"><span>Remaining</span><strong>{{ 100 - total_progress }}%</strong></div>
                <div class="profile-stat"><span>Updates</span><strong>{{ logs|length }}</strong></div>
            </div>
        </section>

        {# Progress bar #}
        <div class="panel au" style="animation-delay:.05s; margin-bottom:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem;">
                <span style="font-weight:700;font-size:.9rem;">Overall Completion</span>
                <span style="font-weight:800;font-size:1.15rem;color:{% if total_progress >= 100 %}#16a34a{% elseif total_progress >= 50 %}#7c3aed{% else %}#d97706{% endif %};">{{ total_progress }}%</span>
            </div>
            <div class="progress-bar-shell">
                <div class="progress-bar-fill" id="pbar" style="--pct:{{ total_progress }}%"></div>
            </div>
            <p class="muted-copy" style="font-size:.8rem; margin:.4rem 0 0;">
                {% if total_progress >= 100 %}🎉 This job is 100% complete!{% else %}{{ 100 - total_progress }}% remaining{% endif %}
            </p>
        </div>

        <div style="display:grid;grid-template-columns:1fr 320px;gap:1.5rem;align-items:start;">

            {# ── Log History ── #}
            <div>
                <h2 style="font-size:1rem;font-weight:700;color:#374151;margin-bottom:1rem;">Progress History</h2>
                {% if logs is empty %}
                    <div style="text-align:center;padding:3rem 1.5rem;background:#faf9ff;border:1.5px dashed #d4c9fe;border-radius:.85rem;">
                        <div style="font-size:2.5rem;margin-bottom:.75rem;">📝</div>
                        <p class="muted-copy">No progress logged yet.</p>
                    </div>
                {% else %}
                    <div style="display:flex;flex-direction:column;gap:.7rem;">
                        {% for log in logs %}
                            <div class="log-card" style="--d:{{ loop.index0 * 55 }}ms;">
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;">
                                    <span class="pct-badge">+{{ log.progressChange }}%</span>
                                    <span class="muted-copy" style="font-size:.78rem;">{{ log.createdAt|date('M d, Y  H:i') }}</span>
                                </div>
                                <p style="font-size:.88rem;line-height:1.65;margin:0;color:#374151;">{{ log.description }}</p>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {# ── Log / Info sidebar ── #}
            <div style="display:flex;flex-direction:column;gap:1rem;">
                {% if is_freelancer and total_progress < 100 %}
                    <section class="panel">
                        <div class="panel-heading">
                            <h2>Log New Progress</h2>
                            <p>Describe what you completed and how much of the project it represents.</p>
                        </div>

                        {% if error %}
                            <div class="form-banner form-banner-error">{{ error }}</div>
                        {% endif %}

                        <form method="POST" action="{{ path('app_job_progress', {id:job.id}) }}" class="form-grid">
                            <input type="hidden" name="_token" value="{{ csrf_token('work_log_' ~ job.id) }}">

                            <div class="field-group">
                                <label for="prog" style="display:flex; justify-content:space-between; align-items:center;">
                                    <span>Progress Added (%)</span>
                                    <strong id="prog-val" style="color:#7c3aed; font-size:1.1rem; background:#f3e8ff; padding:.1rem .5rem; border-radius:.4rem;">1%</strong>
                                </label>
                                <input id="prog" type="range" name="progress_change" style="accent-color:#7c3aed; width:100%; margin:.5rem 0;"
                                    min="1" max="{{ 100 - total_progress }}" value="1" required oninput="document.getElementById('prog-val').textContent = this.value + '%'">
                                <p class="helper-text" style="color:#6b7280; margin-top:.2rem;">Max you can add: {{ 100 - total_progress }}%</p>
                            </div>

                            <div class="field-group">
                                <label for="desc">What did you complete?</label>
                                <textarea id="desc" name="description" class="textarea-input" rows="4"
                                    placeholder="Describe the work done in this session..." required></textarea>
                            </div>

                            <button class="primary-button" type="submit" style="width:100%;">📊 Log Progress</button>
                        </form>
                    </section>
                {% elseif is_freelancer and total_progress >= 100 %}
                    <div class="panel" style="text-align:center;padding:2rem;">
                        <div style="font-size:2.5rem;margin-bottom:.75rem;">🎉</div>
                        <h3 style="font-weight:700;margin-bottom:.4rem;">100% Complete!</h3>
                        <p class="muted-copy">Congratulations on finishing this job.</p>
                    </div>
                {% endif %}

                {% if is_owner %}
                    <section class="panel">
                        <div class="panel-heading"><h2>Freelancer</h2></div>
                        {% if application %}
                            <div style="display:flex;align-items:center;gap:.75rem;">
                                <div class="review-card-avatar">{{ application.user.initials }}</div>
                                <div>
                                    <strong>{{ application.user.displayName }}</strong>
                                    <p class="muted-copy" style="font-size:.8rem;margin:.1rem 0 0;">{{ application.user.email }}</p>
                                </div>
                            </div>
                        {% else %}
                            <p class="muted-copy">No accepted freelancer yet.</p>
                        {% endif %}
                    </section>
                {% endif %}

                <section class="panel">
                    <div class="panel-heading"><h2>Job Info</h2></div>
                    <div style="display:flex;flex-direction:column;gap:.6rem;font-size:.88rem;">
                        <div><span class="muted-copy" style="font-size:.75rem;">Company</span><p style="margin:.1rem 0 0;">{{ job.company }}</p></div>
                        <div><span class="muted-copy" style="font-size:.75rem;">Location</span><p style="margin:.1rem 0 0;">{{ job.location }}</p></div>
                        {% if job.jobType %}<div><span class="muted-copy" style="font-size:.75rem;">Type</span><p style="margin:.1rem 0 0;">{{ job.jobType }}</p></div>{% endif %}
                    </div>
                    <a class="ghost-button compact-button" href="{{ path('app_job_show', {id:job.id}) }}" style="margin-top:1rem;display:inline-block;">View Job</a>
                </section>
            </div>
        </div>
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var bar = document.getElementById('pbar');
    if (bar) {
        setTimeout(function () { bar.style.width = bar.style.getPropertyValue('--pct') || '0%'; }, 120);
    }
});
</script>
{% endblock %}
