<header class="site-header">
    <a class="brand" href="{{ path('app_home') }}">
        <span class="brand-mark">5</span>
        <span class="brand-copy">
            <strong>5ademni.tn</strong>
            <small>Freelance marketplace</small>
        </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
        <a href="{{ is_granted('ROLE_ADMIN') ? path('app_module_placeholder', {slug: 'jobs-management'}) : path('app_module_placeholder', {slug: 'jobs'}) }}">Jobs Management</a>
        <a href="{{ path('app_module_placeholder', {slug: 'jobs'}) }}">Jobs</a>
        <div class="nav-dropdown">
            <button type="button" class="nav-dropdown-trigger">Categories</button>
            <div class="nav-dropdown-menu">
                <a href="{{ path('app_module_placeholder', {slug: 'categories'}) }}">Manage Categories</a>
                <a href="{{ path('app_module_placeholder', {slug: 'gigs'}) }}">Manage Gigs</a>
            </div>
        </div>
        <a href="{{ path('app_module_placeholder', {slug: 'messages'}) }}">Messages</a>
        <a href="{{ path('app_module_placeholder', {slug: 'blogs'}) }}">Blogs</a>
        <a href="{{ path('app_module_placeholder', {slug: 'articles'}) }}">Articles</a>
        <a href="{{ path('app_reviews') }}">Reviews</a>
        <a href="{{ path('app_contrat_index') }}">Contracts</a>
        <a href="{{ path('app_payment_index') }}">Payments</a>
    </nav>

    <div class="header-account">
        <a class="profile-chip" href="{{ path('app_profile') }}">Profile</a>
        <div class="avatar-badge" aria-label="{{ app.user.displayName }}">
            {% if avatar_proxy_enabled|default(false) %}
                <img src="{{ path('app_my_avatar', {v: app.user.avatarVersion}) }}" alt="{{ app.user.displayName }}">
            {% else %}
                <span>{{ app.user.initials }}</span>
            {% endif %}
        </div>
    </div>
</header>
