{% extends 'base.html.twig' %}

{% block title %}Job Management | 5ademni.tn{% endblock %}

{% block body %}
<style>
@keyframes fadeUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }

.management-hero {
    background: #1e1b4b; /* Deep back-office color */
    border-radius: 1rem;
    padding: 2.5rem 2rem;
    margin-bottom: 2rem;
    color: #fff;
    animation: fadeUp .4s ease both;
}
.management-hero h1 { font-size:2rem; font-weight:800; margin:0 0 .3rem; }
.management-hero p { color:#a5b4fc; margin:0; font-size:.95rem; }

.posting-card {
    background:#fff; border:1.5px solid #e5e7eb; border-radius:.85rem;
    padding:1.4rem 1.6rem; display:flex; align-items:flex-start;
    gap:1rem; justify-content:space-between; flex-wrap:wrap;
    transition:transform .22s, box-shadow .22s, border-color .22s;
    animation:fadeUp .4s ease var(--delay,0ms) both;
}
.posting-card:hover { transform:translateY(-2px); box-shadow:0 6px 22px rgba(0,0,0,.08); border-color:#818cf8; }

.posting-badge {
    display:inline-block; padding:.2rem .65rem; border-radius:999px;
    font-size:.74rem; font-weight:700; background:#e0e7ff; color:#3730a3;
}
.posting-badge.orange { background:#ffedd5; color:#9a3412; }

.action-btn {
    padding:.45rem .95rem; border-radius:.5rem; font-size:.85rem; font-weight:700;
    cursor:pointer; text-decoration:none; border:1.5px solid transparent;
    transition:all .2s; white-space:nowrap; display:inline-flex; align-items:center; gap:.4rem;
}
.action-btn.outline { border-color:#e5e7eb; background:#fff; color:#374151; }
.action-btn.outline:hover { border-color:#c4b5fd; color:#6d28d9; background:#f5f3ff; }
.action-btn.danger { border-color:#fecaca; background:#fff; color:#dc2626; }
.action-btn.danger:hover { background:#fee2e2; }
.action-btn.primary { background:#4f46e5; color:#fff; border-color:#4f46e5; }
.action-btn.primary:hover { background:#4338ca; }

.stat-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:2rem;
}
.stat-box {
    background:#fff; border:1.5px solid #e5e7eb; border-radius:.75rem;
    padding:1.25rem; text-align:center;
    animation:fadeUp .4s ease both;
}
.stat-box strong { font-size:2.2rem; font-weight:800; color:#4f46e5; display:block; line-height:1; margin-bottom:.2rem; }
.stat-box span   { font-size:.8rem; color:#6b7280; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }
</style>

<div class="page-shell">
    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <div class="management-hero">
            <p class="eyebrow" style="color:#c4b5fd; margin-bottom:.5rem;">Back Office</p>
            <h1>Job Management</h1>
            <p>Manage your listings, review applicants, and track freelancer progress.</p>
        </div>

        {# Stats #}
        <div class="stat-grid">
            <div class="stat-box" style="--delay:0ms;">
                <strong>{{ jobs|length }}</strong>
                <span>Total Postings</span>
            </div>
            <div class="stat-box" style="animation-delay:.06s;">
                <strong>{{ jobs|filter(j => j.applications|length > 0)|length }}</strong>
                <span>Active Listings</span>
            </div>
            <div class="stat-box" style="animation-delay:.12s;">
                <strong>{{ total_saves }}</strong>
                <span>Total Saves</span>
            </div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:.75rem;">
            <h2 style="font-size:1.1rem; font-weight:700; margin:0; color:#111827;">Your Postings</h2>
            <a class="action-btn primary" href="{{ path('app_job_new') }}">➕ Create New Job</a>
        </div>

        {# Listing #}
        <div style="display:flex; flex-direction:column; gap:1rem;">
            {% for job in jobs %}
                <div class="posting-card" style="--delay:{{ loop.index0 * 55 }}ms;">
                    <div style="flex:1 1 0; min-width:0;">
                        <p style="font-size:1.1rem; font-weight:800; margin:0 0 .3rem;">
                            <a href="{{ path('app_job_show', {id: job.id}) }}" style="color:#111827; text-decoration:none; transition:color .2s;" onmouseover="this.style.color='#4f46e5'" onmouseout="this.style.color='#111827'">{{ job.title }}</a>
                        </p>
                        <p class="muted-copy" style="font-size:.88rem; margin:0 0 .75rem;">
                            🏢 {{ job.company }} &bull; 📍 {{ job.location }} &bull; 📅 {{ job.postedDate|date('M d, Y') }}
                        </p>
                        <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
                            {% if job.jobType %}<span class="posting-badge">{{ job.jobType }}</span>{% endif %}
                            <span class="posting-badge orange">{{ job.category }}</span>
                            <span class="posting-badge" style="background:#f3f4f6; color:#4b5563;">👥 {{ job.applications|length }} Applicants</span>
                        </div>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:.5rem; align-items:flex-end;">
                        <div style="display:flex; gap:.5rem;">
                            <a class="action-btn primary" href="{{ path('app_management_job_applications', {id: job.id}) }}">
                                👥 Review Applicants
                            </a>
                        </div>
                        <div style="display:flex; gap:.5rem; margin-top:.25rem;">
                            <a class="action-btn outline" href="{{ path('app_job_progress', {id: job.id}) }}">📊 Progress</a>
                            <a class="action-btn outline" href="{{ path('app_job_edit', {id: job.id}) }}">✏ Edit</a>
                            <form method="POST" action="{{ path('app_job_delete', {id: job.id}) }}" onsubmit="return confirm('Delete this posting?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ job.id) }}">
                                <button type="submit" class="action-btn danger">🗑 Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div style="text-align:center; padding:4rem 2rem; background:#f9fafb; border:1.5px dashed #d1d5db; border-radius:1rem; animation:fadeUp .4s ease both;">
                    <div style="font-size:3rem; margin-bottom:1rem;">📋</div>
                    <h3 style="font-size:1.25rem; font-weight:800; margin-bottom:.5rem;">No postings yet</h3>
                    <p class="muted-copy" style="margin-bottom:1.5rem;">Start attracting great talent by creating your first job listing.</p>
                    <a class="action-btn primary" href="{{ path('app_job_new') }}">➕ Create Your First Job</a>
                </div>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock %}
