{% extends 'base.html.twig' %}

{% block title %}Manage Applications — {{ job.title }} | 5ademni.tn{% endblock %}

{% block body %}
<style>
@keyframes fadeUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
.card-animate { animation: fadeUp .4s ease var(--delay, 0ms) both; }

.management-hero {
    background: #1e1b4b; /* Deep back-office color */
    border-radius: 1rem;
    padding: 2rem;
    margin-bottom: 2rem;
    color: #fff;
    animation: fadeUp .4s ease both;
}
.management-hero h1 { font-size:1.8rem; font-weight:800; margin:0 0 .3rem; }
.management-hero p { color:#a5b4fc; margin:0; font-size:.95rem; }

.review-card {
    background:#fff; border:1.5px solid #e5e7eb; border-radius:.75rem;
    display:flex; flex-direction:column; gap:.75rem;
    transition: transform .2s ease, box-shadow .2s ease;
}
.review-card:hover { transform: translateY(-2px); box-shadow:0 6px 16px rgba(0,0,0,.08); }

.status-form { display:flex; gap:.4rem; align-items:center; }
.status-select {
    padding:.35rem .6rem; border:1.5px solid #d1d5db; border-radius:.4rem;
    font-size:.85rem; font-weight:600; outline:none; cursor:pointer;
}
.status-select:focus { border-color:#4f46e5; box-shadow:0 0 0 3px rgba(79,70,229,.15); }
.action-btn {
    padding:.35rem .8rem; border-radius:.4rem; font-size:.85rem; font-weight:600;
    cursor:pointer; text-decoration:none; border:1.5px solid transparent;
}
.action-btn.outline { border-color:#e5e7eb; background:#fff; color:#374151; }
.action-btn.outline:hover { background:#f9fafb; border-color:#d1d5db; }

/* Status Labels */
.status-label {
    font-size: .8rem; font-weight: 700;
    padding: .3rem .75rem; border-radius: 999px; white-space: nowrap;
}
.status-PENDING { color: #92400e; background: #fef3c7; }
.status-ACCEPTED { color: #166534; background: #dcfce7; }
.status-REJECTED { color: #991b1b; background: #fee2e2; }
.status-INTERVIEWING { color: #1e3a8a; background: #dbeafe; }
.status-IN_PROGRESS { color: #0369a1; background: #e0f2fe; }
.status-COMPLETED { color: #3f6212; background: #ecfccb; }

.analysis-box {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: .75rem;
    font-size: .88rem;
    display: none;
    animation: fadeUp .3s ease;
}
.analysis-box.SAFE { background: #f0fdf4; border: 1.5px solid #bbf7d0; color: #166534; }
.analysis-box.AVERAGE { background: #fffbeb; border: 1.5px solid #fef3c7; color: #92400e; }
.analysis-box.SUSPICIOUS { background: #fef2f2; border: 1.5px solid #fee2e2; color: #991b1b; }

.ai-badge {
    font-size: .7rem;
    background: #4f46e5;
    color: white;
    padding: .1rem .4rem;
    border-radius: 4px;
    margin-right: .4rem;
    text-transform: uppercase;
    font-weight: 800;
}
</style>

<div class="page-shell">
    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <p style="margin-bottom:1rem;" class="card-animate">
            <a href="{{ path('app_management_jobs_index') }}" style="color:#6b7280; text-decoration:none; font-size:.88rem; font-weight:600;">← Back to Job Management</a>
        </p>

        <div class="management-hero">
            <p class="eyebrow" style="color:#c4b5fd; margin-bottom:.5rem;">Applicants Review</p>
            <h1>{{ job.title }}</h1>
            <p>{{ job.company }} &mdash; Handle applications for this position.</p>
        </div>

        {% if accepted_app %}
            <section class="panel card-animate" style="--delay: 50ms; margin-bottom: 2rem; border: 1.5px solid #10b981;">
                <div class="panel-heading" style="display:flex; justify-content:space-between; align-items:center;">
                    <h2 style="color:#065f46;">📊 Active Assignment</h2>
                    <span class="status-label status-{{ accepted_app.status }}">{{ accepted_app.status|replace({'_': ' '}) }}</span>
                </div>
                
                <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">
                    <div style="flex: 1 1 300px;">
                        <div style="display:flex; justify-content:space-between; font-size:.85rem; font-weight:700; margin-bottom:.5rem; color:#374151;">
                            <span>Completion Status</span>
                            <span>{{ total_progress }}%</span>
                        </div>
                        <div style="height:12px; background:#e5e7eb; border-radius:999px; overflow:hidden;">
                            <div style="width:{{ total_progress }}%; height:100%; background:linear-gradient(90deg, #10b981 0%, #34d399 100%); border-radius:999px; transition:width 1s ease-out;"></div>
                        </div>
                    </div>
                    
                    <div style="display:flex; align-items:center; gap:.75rem; background:#f0fdf4; padding:.75rem 1rem; border-radius:.6rem; border:1px solid #dcfce7;">
                        <div class="review-card-avatar" style="width:36px; height:36px;">{{ accepted_app.user.initials }}</div>
                        <div>
                            <p style="font-size:.78rem; font-weight:800; color:#065f46; margin:0; text-transform:uppercase;">Assigned Freelancer</p>
                            <p style="font-size:.9rem; font-weight:700; color:#111827; margin:0;">{{ accepted_app.user.displayName }}</p>
                        </div>
                    </div>
                    
                    <a class="action-btn primary" href="{{ path('app_job_progress', {id: job.id}) }}" style="background:#10b981; border-color:#10b981;">
                        View Detailed Progress Logs →
                    </a>

                    <a class="action-btn outline" href="{{ path('app_contrat_create_from_job', {id: job.id}) }}">
                        Create Contract
                    </a>
                </div>
            </section>
        {% endif %}

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:.75rem;">
            <h2 style="font-size:1.1rem; font-weight:700; margin:0; color:#111827;">Candidates ({{ applications|length }})</h2>
        </div>

        <div style="display:flex; flex-direction:column; gap:1rem;">
            {% for app in applications %}
                <article class="review-card card-animate" style="--delay: {{ loop.index0 * 60 }}ms; padding: 1.25rem;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap;">
                        <div style="display:flex; align-items:center; gap:.75rem;">
                            <div class="review-card-avatar" style="width:40px;height:40px;font-size:1rem;">{{ app.user.initials }}</div>
                            <div>
                                <strong style="font-size:1.05rem;">{{ app.user.displayName }}</strong>
                                <p class="muted-copy" style="margin:.1rem 0 0; font-size:.85rem;">{{ app.user.email }}</p>
                                <p class="muted-copy" style="margin:.1rem 0 0; font-size:.8rem;">Applied {{ app.applicationDate|date('M d, Y') }}</p>
                            </div>
                        </div>

                        <span class="status-label status-{{ app.status }}">{{ app.status }}</span>
                    </div>

                    <div style="margin-top:.5rem; padding:1rem; background: #f9fafb; border-radius:.5rem; font-size:.87rem; line-height:1.65; border-left: 3px solid #4f46e5;">
                        <p style="font-weight:600; margin-bottom:.35rem; color:#111827;">{{ app.title }}</p>
                        <p style="color:#4b5563; margin:0;">{{ app.description|nl2br }}</p>
                    </div>

                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:.5rem; flex-wrap:wrap; gap:.5rem;">
                        <form method="POST" action="{{ path('app_management_application_status', {id: app.id}) }}" class="status-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('status' ~ app.id) }}">
                            <select name="status" class="status-select" onchange="this.form.submit()">
                                <option value="PENDING"      {% if app.status == 'PENDING' %}selected{% endif %}>⏳ Pending</option>
                                <option value="INTERVIEWING" {% if app.status == 'INTERVIEWING' %}selected{% endif %}>💬 Interviewing</option>
                                <option value="REJECTED"     {% if app.status == 'REJECTED' %}selected{% endif %}>❌ Rejected</option>
                                
                                {% if not accepted_app or accepted_app.id == app.id %}
                                    <option value="ACCEPTED"     {% if app.status == 'ACCEPTED' %}selected{% endif %}>✅ Accepted</option>
                                    <option value="IN_PROGRESS"  {% if app.status == 'IN_PROGRESS' %}selected{% endif %}>🚀 In Progress</option>
                                    <option value="COMPLETED"    {% if app.status == 'COMPLETED' %}selected{% endif %}>🏁 Completed</option>
                                {% endif %}
                            </select>
                        </form>

                        {% if app.cvPath %}
                            <div style="display:flex; gap:.5rem;">
                                <a class="action-btn outline" href="{{ asset(app.cvPath) }}" target="_blank">📄 Open CV Document</a>
                                <button type="button" class="action-btn outline analyze-cv-btn" 
                                        data-url="{{ path('app_management_application_analyze', {id: app.id}) }}"
                                        data-app-id="{{ app.id }}">
                                    ✨ Analyze with AI
                                </button>
                            </div>
                        {% endif %}
                    </div>

                    <div id="analysis-result-{{ app.id }}" class="analysis-box">
                        <!-- Result will be injected here -->
                    </div>
                </article>
            {% else %}
                <div style="text-align:center; padding:3rem 2rem; background:#f9fafb; border:1.5px dashed #d1d5db; border-radius:1rem;">
                    <div style="font-size:2.5rem; margin-bottom:.75rem;">👥</div>
                    <h3 style="font-size:1.1rem; font-weight:800; margin-bottom:.5rem;">No applications yet</h3>
                    <p class="muted-copy">When candidates apply to this position, they will appear here.</p>
                </div>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.querySelectorAll('.analyze-cv-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
        const appId = this.getAttribute('data-app-id');
        const url = this.getAttribute('data-url');
        const resultBox = document.getElementById(`analysis-result-${appId}`);
        
        // Loading state
        this.disabled = true;
        const originalText = this.innerHTML;
        this.innerHTML = '⌛ Analyzing...';
        
        resultBox.style.display = 'block';
        resultBox.className = 'analysis-box AVERAGE'; // Default color while loading
        resultBox.innerHTML = '<div style="display:flex; align-items:center; gap:.5rem;"><div class="spinner"></div> Running AI evaluation...</div>';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const data = await response.json();
            
            if (data.error) {
                resultBox.className = 'analysis-box SUSPICIOUS';
                resultBox.innerHTML = `<strong>Error:</strong> ${data.error}`;
            } else {
                resultBox.className = `analysis-box ${data.status}`;
                resultBox.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.5rem;">
                        <span style="font-weight:800; display:flex; align-items:center;">
                            <span class="ai-badge">AI Score</span> 
                            Score: ${data.score}/100
                        </span>
                        <span class="status-label status-${data.status}">${data.status}</span>
                    </div>
                    <p style="margin:0; font-weight:500;">${data.reason}</p>
                `;
            }
        } catch (err) {
            resultBox.className = 'analysis-box SUSPICIOUS';
            resultBox.innerHTML = '<strong>Error:</strong> Failed to connect to analysis service.';
        } finally {
            this.disabled = false;
            this.innerHTML = originalText;
        }
    });
});
</script>

<style>
.spinner {
    width: 16px; height: 16px;
    border: 2px solid rgba(0,0,0,.1);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
</style>
{% endblock %}
