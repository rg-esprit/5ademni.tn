{% extends 'base.html.twig' %}

{% block title %}Apply — {{ job.title }} | 5ademni.tn{% endblock %}

{% block body %}
<style>
@keyframes fadeUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
.form-panel { animation: fadeUp .45s ease both; }

.field-group label {
    display:block; font-size:.8rem; font-weight:700;
    text-transform:uppercase; letter-spacing:.05em;
    color:#374151; margin-bottom:.4rem;
}
.field-group .text-input,
.field-group .textarea-input {
    width:100%; box-sizing:border-box;
    padding:.65rem .95rem;
    border:1.5px solid #e5e7eb; border-radius:.5rem;
    font-size:.93rem; color:#111; background:#f9fafb;
    transition:border-color .2s, box-shadow .2s, background .2s;
    outline:none;
}
.field-group .text-input:focus,
.field-group .textarea-input:focus {
    border-color:#6366f1; background:#fff;
    box-shadow:0 0 0 3px rgba(99,102,241,.15);
}
.helper-text { font-size:.8rem; color:#dc2626; margin:.3rem 0 0; }
.section-title {
    font-size:.7rem; font-weight:800; text-transform:uppercase;
    letter-spacing:.1em; color:#6366f1;
    padding-bottom:.5rem; border-bottom:2px solid #ede9fe;
    margin:1.5rem 0 1rem;
}
.job-summary-pill {
    display:inline-flex; align-items:center; gap:.4rem;
    padding:.3rem .75rem; border-radius:999px;
    background:#ede9fe; color:#5b21b6;
    font-size:.8rem; font-weight:700;
}
</style>

<div class="page-shell">
    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <section class="review-hero">
            <div>
                <p class="eyebrow">Application</p>
                <h1>Apply for this Position</h1>
                <p class="muted-copy">{{ job.title }} at <strong>{{ job.company }}</strong> — {{ job.location }}</p>
            </div>
        </section>

        <div style="display:grid; grid-template-columns:1fr 280px; gap:1.5rem; align-items:start;">

            {# ── Application form ── #}
            <div class="panel form-panel">
                <div class="panel-heading">
                    <h2>Your Application</h2>
                    <p>Write a compelling pitch and attach your CV (PDF, max 5 MB).</p>
                </div>

                {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}

                <div class="field-group">
                    {{ form_label(form.title, 'Application Subject') }}
                    {{ form_widget(form.title, {attr: {class: 'text-input', placeholder: 'e.g. PHP Developer Application'}}) }}
                    <p class="helper-text">{{ form_errors(form.title) }}</p>
                </div>

                <p class="section-title">Cover Letter</p>

                <div class="field-group">
                    {{ form_label(form.description, 'Why are you the best fit?') }}
                    {{ form_widget(form.description, {attr: {class: 'textarea-input', rows: 8, placeholder: 'Describe your experience, skills, and why you are excited about this role...'}}) }}
                    <p class="helper-text">{{ form_errors(form.description) }}</p>
                </div>

                <p class="section-title">CV / Resume</p>

                <div class="field-group" style="padding:1rem; background:#f9fafb; border:1.5px dashed #d1d5db; border-radius:.6rem;">
                    {{ form_label(form.cvFile, '📎 Attach your CV (PDF only)') }}
                    {{ form_widget(form.cvFile, {attr: {accept: '.pdf'}}) }}
                    <p class="helper-text" style="color:#6b7280;">Max file size: 5 MB. Only PDF format is accepted.</p>
                    {{ form_errors(form.cvFile) }}
                </div>

                <div class="inline-actions" style="margin-top:1.5rem;">
                    <a class="ghost-button" href="{{ path('app_job_show', {id: job.id}) }}">Cancel</a>
                    <button class="primary-button" type="submit">🚀 Submit Application</button>
                </div>

                {{ form_end(form) }}
            </div>

            {# ── Job summary sidebar ── #}
            <div style="display:flex; flex-direction:column; gap:1rem;">
                <section class="panel" style="animation: fadeUp .5s ease .1s both;">
                    <div class="panel-heading">
                        <h2>Job Summary</h2>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:.8rem; font-size:.9rem;">
                        <div>
                            <span class="muted-copy" style="font-size:.75rem;">Position</span>
                            <p style="margin:.15rem 0 0; font-weight:700;">{{ job.title }}</p>
                        </div>
                        <div>
                            <span class="muted-copy" style="font-size:.75rem;">Company</span>
                            <p style="margin:.15rem 0 0;">{{ job.company }}</p>
                        </div>
                        <div>
                            <span class="muted-copy" style="font-size:.75rem;">Location</span>
                            <p style="margin:.15rem 0 0;">📍 {{ job.location }}</p>
                        </div>
                        {% if job.jobType %}
                        <div>
                            <span class="muted-copy" style="font-size:.75rem;">Type</span>
                            <p style="margin:.15rem 0 0;">🏷 {{ job.jobType }}</p>
                        </div>
                        {% endif %}
                        {% if job.salaryDisplay %}
                        <div>
                            <span class="muted-copy" style="font-size:.75rem;">Salary</span>
                            <p style="margin:.15rem 0 0;">💰 {{ job.salaryDisplay }}</p>
                        </div>
                        {% endif %}
                        <div>
                            <span class="muted-copy" style="font-size:.75rem;">Category</span>
                            <p style="margin:.15rem 0 0;">
                                <span class="job-summary-pill">{{ job.category }}</span>
                            </p>
                        </div>
                    </div>
                </section>

                <section class="panel" style="animation: fadeUp .5s ease .2s both;">
                    <div class="panel-heading"><h2>Recruiter</h2></div>
                    <div style="display:flex; align-items:center; gap:.75rem;">
                        <div class="review-card-avatar">{{ job.user.initials }}</div>
                        <div>
                            <strong>{{ job.user.displayName }}</strong>
                            <p class="muted-copy" style="margin:.1rem 0 0; font-size:.8rem;">{{ job.user.email }}</p>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>
</div>
{% endblock %}
