{% extends 'base.html.twig' %}

{% block title %}Nouvelle conversation | 5ademni.tn{% endblock %}

{% block body %}
    <div class="page-shell">
        {% include 'partials/_header.html.twig' %}

        <main class="page-content">
            <section class="page-card page-card-form">
                <div class="page-card-header">
                    <div>
                        <p class="eyebrow">Messagerie</p>
                        <h1>Nouvelle conversation</h1>
                    </div>
                    <a class="secondary-button" href="{{ path('app_conversations') }}">Retour aux conversations</a>
                </div>

                {% if error %}
                    <div class="alert alert-error">{{ error }}</div>
                {% endif %}

                <form method="post" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('conversation_new') }}" />
                    <input type="hidden" name="recipient" value="{{ recipient.getId() }}" />
                    <input type="hidden" name="source" value="{{ source }}" />

                    <div class="form-group">
                        <label>Destinataire</label>
                        <div class="text-input" style="display:flex; align-items:center; min-height:48px; background:#f8f5ff;">
                            {{ recipient.getDisplayName() }} &lt;{{ recipient.getEmail() }}&gt;
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="title">Objet</label>
                        <input id="title" name="title" type="text" placeholder="Titre de la conversation" maxlength="255" value="{{ draftTitle|default('') }}" />
                    </div>

                    <button class="primary-button" type="submit">Créer la conversation</button>
                </form>
            </section>
        </main>
    </div>
{% endblock %}
