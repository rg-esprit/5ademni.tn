{% extends 'base.html.twig' %}

{% block title %}My Job Postings | 5ademni.tn{% endblock %}

{% block body %}
<style>
@keyframes fadeUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }

.posting-card {
    background:#fff; border:1.5px solid #e5e7eb; border-radius:.85rem;
    padding:1.25rem 1.5rem; display:flex; align-items:center;
    gap:1rem; justify-content:space-between; flex-wrap:wrap;
    transition:transform .22s, box-shadow .22s, border-color .22s;
    animation:fadeUp .4s ease var(--delay,0ms) both;
}
.posting-card:hover { transform:translateY(-2px); box-shadow:0 6px 22px rgba(0,0,0,.08); border-color:#a5b4fc; }

.posting-badge {
    display:inline-block; padding:.2rem .65rem; border-radius:999px;
    font-size:.74rem; font-weight:700; background:#ede9fe; color:#5b21b6;
}
.posting-badge.blue { background:#dbeafe; color:#1d4ed8; }

.action-btn {
    padding:.38rem .85rem; border-radius:.45rem; font-size:.82rem; font-weight:600;
    cursor:pointer; text-decoration:none; border:1.5px solid transparent;
    transition:all .18s; white-space:nowrap;
}
.action-btn.outline { border-color:#e5e7eb; background:#fff; color:#374151; }
.action-btn.outline:hover { border-color:#a5b4fc; color:#6366f1; background:#f5f3ff; }
.action-btn.danger { border-color:#fecaca; background:#fff; color:#dc2626; }
.action-btn.danger:hover { background:#fee2e2; }
.action-btn.primary { background:#6366f1; color:#fff; border-color:#6366f1; }
.action-btn.primary:hover { background:#4f46e5; }

.stat-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:1.5rem;
}
.stat-box {
    background:#fff; border:1.5px solid #e5e7eb; border-radius:.75rem;
    padding:1rem 1.25rem; text-align:center;
    animation:fadeUp .4s ease both;
}
.stat-box strong { font-size:2rem; font-weight:800; color:#6366f1; display:block; }
.stat-box span   { font-size:.8rem; color:#6b7280; font-weight:600; text-transform:uppercase; letter-spacing:.05em; }
</style>

<div class="page-shell">
    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <section class="review-hero">
            <div>
                <p class="eyebrow">Management</p>
                <h1>My Job Postings</h1>
                <p class="muted-copy">Manage your listings, review applicants, and track activity.</p>
            </div>
        </section>

        {# Stats #}
        <div class="stat-grid">
            <div class="stat-box" style="--delay:0ms;">
                <strong>{{ jobs|length }}</strong>
                <span>Postings</span>
            </div>
            <div class="stat-box" style="animation-delay:.06s;">
                <strong>{{ jobs|filter(j => j.jobType == 'Full-time')|length }}</strong>
                <span>Full-time</span>
            </div>
            <div class="stat-box" style="animation-delay:.12s;">
                <strong>{{ jobs|filter(j => j.jobType == 'Freelance')|length }}</strong>
                <span>Freelance</span>
            </div>
        </div>

        {# Toolbar #}
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:.75rem;">
            <h2 style="font-size:1rem; font-weight:700; margin:0; color:#374151;">
                {{ jobs|length }} posting{{ jobs|length == 1 ? '' : 's' }}
            </h2>
            <a class="action-btn primary" href="{{ path('app_job_new') }}">+ Post New Job</a>
        </div>

        {# Listing #}
        <div style="display:flex; flex-direction:column; gap:.75rem;">
            {% for job in jobs %}
                <div class="posting-card" style="--delay:{{ loop.index0 * 55 }}ms;">
                    <div style="flex:1 1 0; min-width:0;">
                        <p style="font-size:1rem; font-weight:700; margin:0 0 .25rem;">
                            <a href="{{ path('app_job_show', {id: job.id}) }}" style="color:inherit; text-decoration:none; transition:color .2s;" onmouseover="this.style.color='#6366f1'" onmouseout="this.style.color='inherit'">{{ job.title }}</a>
                        </p>
                        <p class="muted-copy" style="font-size:.85rem; margin:0 0 .5rem;">
                            🏢 {{ job.company }} &bull; 📍 {{ job.location }} &bull; 📅 {{ job.postedDate|date('M d, Y') }}
                        </p>
                        <div style="display:flex; gap:.4rem; flex-wrap:wrap;">
                            {% if job.jobType %}<span class="posting-badge">{{ job.jobType }}</span>{% endif %}
                            <span class="posting-badge blue">{{ job.category }}</span>
                        </div>
                    </div>

                    <div style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
                        <a class="action-btn primary" href="{{ path('app_management_job_applications', {id: job.id}) }}">
                            Applications
                        </a>
                        <a class="action-btn outline" href="{{ path('app_job_edit', {id: job.id}) }}">✏ Edit</a>
                        <form method="POST" action="{{ path('app_job_delete', {id: job.id}) }}" onsubmit="return confirm('Delete this posting?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ job.id) }}">
                            <button type="submit" class="action-btn danger">🗑 Delete</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div style="text-align:center; padding:4rem 2rem; background:#fff; border:1.5px dashed #e5e7eb; border-radius:.85rem; animation:fadeUp .4s ease both;">
                    <div style="font-size:3rem; margin-bottom:.75rem;">📋</div>
                    <h3 style="font-size:1.15rem; font-weight:700; margin-bottom:.5rem;">No postings yet</h3>
                    <p class="muted-copy" style="margin-bottom:1.25rem;">Start attracting great talent by creating your first job listing.</p>
                    <a class="action-btn primary" href="{{ path('app_job_new') }}">+ Post Your First Job</a>
                </div>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock %}
