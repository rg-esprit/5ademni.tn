<form method="post" action="{{ path('admin_payment_delete', {'id': payment.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce paiement ?');" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ payment.id) }}">
    <button class="button-danger">🗑️ Supprimer</button>
</form>
