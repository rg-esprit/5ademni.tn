<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Recu de paiement #{{ payment.id }}</title>
    <style>
        body { font-family: Arial, sans-serif; color: #1f2937; line-height: 1.5; }
        .header { background: #111827; color: #fff; padding: 24px; }
        .header h1 { margin: 0; font-size: 24px; }
        .content { padding: 32px 24px; }
        table { width: 100%; border-collapse: collapse; margin-top: 24px; }
        th, td { padding: 12px; border-bottom: 1px solid #e5e7eb; text-align: left; }
        th { width: 32%; color: #6b7280; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
        .amount { font-size: 28px; font-weight: 700; color: #10b981; }
        .footer { margin-top: 48px; font-size: 12px; color: #6b7280; }
    </style>
</head>
<body>
    <div class="header" style="position: relative; padding-left: 100px;">
        <div style="position: absolute; top: 15px; left: 24px; width: 50px; height: 50px; border-radius: 10px; overflow: hidden; background: white; padding: 4px;">
            <img src="{{ brand_logo(payment.contrat ? payment.contrat.titre : 'Payment') }}" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;">
        </div>
        <h1>Recu de paiement</h1>
        <div>Reference: PAY-{{ "%04d"|format(payment.id) }}</div>
    </div>

    <div class="content">
        <table>
            <tr>
                <th>Paiement</th>
                <td>#{{ payment.id }}</td>
            </tr>
            <tr>
                <th>Contrat</th>
                <td>{{ payment.contrat ? payment.contrat.titre : 'Contrat indisponible' }}</td>
            </tr>
            <tr>
                <th>ID Contrat</th>
                <td>{{ payment.contrat ? '#' ~ payment.contrat.id : 'N/A' }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ payment.createdAt ? payment.createdAt|date('d/m/Y H:i') : 'N/A' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ payment.status }}</td>
            </tr>
            <tr>
                <th>Session Stripe</th>
                <td>{{ payment.stripeSessionId ?: 'Paiement manuel' }}</td>
            </tr>
            <tr>
                <th>Montant</th>
                <td>
                    <span style="font-size: 28px; font-weight: 700; color: #10b981;">{{ payment.amount }} TND</span><br>
                    <span style="display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 12px; background: #3b5bdb; color: #fff; font-size: 12px; font-weight: 700; margin-right: 4px;">
                        🇪🇺 ≈ {{ payment.amount|convert_currency('TND', 'EUR') }} EUR
                    </span>
                    <span style="display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 12px; background: #10b981; color: #fff; font-size: 12px; font-weight: 700;">
                        🇺🇸 ≈ {{ payment.amount|convert_currency('TND', 'USD') }} USD
                    </span>
                </td>
            </tr>
        </table>

        <div class="footer">
            Document genere le {{ "now"|date('d/m/Y H:i') }}.<br>
            5ademni.tn
        </div>
    </div>
</body>
</html>
