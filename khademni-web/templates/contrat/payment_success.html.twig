{% extends 'base.html.twig' %}

{% block title %}Paiement Réussi{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/contrat_web.css') }}">
{% endblock %}

{% block body %}
{% include 'partials/_header.html.twig' %}
<div class="bento-root" style="display: flex; justify-content: center; align-items: center; min-height: 80vh;">
    <div class="glass-card" style="text-align: center; max-width: 500px; padding: 50px;">
        <div style="font-size: 60px; margin-bottom: 20px;">✅</div>
        <h1 class="bento-card-title" style="color: #10b981; font-size: 32px;">Paiement Réussi !</h1>
        <p class="bento-card-desc" style="font-size: 16px; margin-top: 20px;">
            Votre paiement pour le contrat <strong>#{{ contrat.id }} ({{ contrat.titre }})</strong> a été traité avec succès.
        </p>
        
        <div style="margin-top: 40px; display: flex; gap: 15px; justify-content: center;">
            <a href="{{ path('app_contrat_index') }}" class="button-primary" style="background-color: #6c5ce7;">← Retour aux contrats</a>
            {% if payment is defined and payment %}
                <a href="{{ path('app_payment_export_pdf', {'id': payment.id}) }}" class="button-primary" style="background-color: #1a1a1a;" target="_blank">📄 Télécharger le reçu</a>
            {% else %}
                <a href="{{ path('app_contrat_export_pdf', {'id': contrat.id}) }}" class="button-primary" style="background-color: #1a1a1a;" target="_blank">📄 Télécharger le contrat</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
