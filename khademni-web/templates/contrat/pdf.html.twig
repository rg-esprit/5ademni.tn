<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Contrat #{{ contrat.id }}</title>
    <style>
        body { font-family: 'Arial', sans-serif; color: #333; line-height: 1.6; }
        .header { background-color: #6c5ce7; color: white; padding: 20px; text-align: center; }
        .content { padding: 40px; }
        .info-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .info-table th, .info-table td { padding: 12px; border-bottom: 1px solid #ddd; text-align: left; }
        .info-table th { background-color: #f9f9f9; width: 30%; }
        .footer { text-align: center; margin-top: 50px; font-size: 12px; color: #888; }
        .amount { font-size: 24px; font-weight: bold; color: #6c5ce7; }
        .status { padding: 5px 10px; border-radius: 5px; color: white; font-weight: bold; background-color: #f59e0b; }
        .status.paye { background-color: #10b981; }
    </style>
</head>
<body>
    <div class="header" style="position: relative;">
        <div style="position: absolute; top: 10px; left: 20px; width: 60px; height: 60px; border-radius: 12px; overflow: hidden; background: white; padding: 4px;">
            <img src="{{ brand_logo(clientName|default('Client')) }}" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;">
        </div>
        <h1>CONTRAT DE PRESTATION DE SERVICES</h1>
        <p>Référence: CT-2026-{{ "%04d"|format(contrat.id) }}</p>
    </div>
    
    <div class="content">
        <h2>{{ contrat.titre }}</h2>
        
        <table class="info-table">
            <tr>
                <th>Date du contrat</th>
                <td>{{ contrat.dateContrat ? contrat.dateContrat|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td><span class="status {{ contrat.statut == 'PAYE' ? 'paye' : '' }}">{{ contrat.statut }}</span></td>
            </tr>
            <tr>
                <th>ID Client</th>
                <td>{{ contrat.clientId }}</td>
            </tr>
            <tr>
                <th>ID Freelancer</th>
                <td>{{ contrat.freelancerId }}</td>
            </tr>
            <tr>
                <th>Téléphone</th>
                <td>{{ contrat.numTelephone ?: 'Non spécifié' }}</td>
            </tr>
            <tr>
                <th>Montant</th>
                <td>
                    <span style="font-size: 24px; font-weight: bold; color: #6c5ce7;">{{ contrat.prix }} TND</span><br>
                    <span style="display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 12px; background: #3b5bdb; color: #fff; font-size: 12px; font-weight: 700; margin-right: 4px;">
                        🇪🇺 ≈ {{ contrat.prix|convert_currency('TND', 'EUR') }} EUR
                    </span>
                    <span style="display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 12px; background: #10b981; color: #fff; font-size: 12px; font-weight: 700;">
                        🇺🇸 ≈ {{ contrat.prix|convert_currency('TND', 'USD') }} USD
                    </span>
                </td>
            </tr>
        </table>
        
        <h3>Description des services</h3>
        <p style="background-color: #f9f9f9; padding: 15px; border-left: 4px solid #6c5ce7;">
            {{ contrat.description|nl2br }}
        </p>
        
        <div style="margin-top: 50px;">
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%; text-align: center;">
                        <strong>Signature Client</strong><br><br><br>
                        _________________
                    </td>
                    <td style="width: 50%; text-align: center;">
                        <strong>Signature Freelancer</strong><br><br><br>
                        _________________
                    </td>
                </tr>
            </table>
        </div>
    </div>
    
    <div class="footer">
        5ademni.tn - Plateforme de Freelance en Tunisie<br>
        Généré le {{ "now"|date("d/m/Y H:i") }}
    </div>
</body>
</html>
