{% extends 'base.html.twig' %}

{% block title %}Contrats{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/contrat_web.css') }}">
{% endblock %}

{% block body %}
{% include 'partials/_header.html.twig' %}
<div class="bento-root">
    <div class="top-bar">
        <div>
            <span class="kinetic-label-small">SaaS 2026 // BENTO</span>
            <h1 class="bento-title">Contrats</h1>
        </div>
        
        <div style="display: flex; gap: 15px; align-items: center;">
            <a href="{{ path('app_home') }}" class="button-primary" style="background-color: #1a1a1a;">🏠 Accueil</a>
            <form method="get" action="{{ path('app_contrat_index') }}" onsubmit="return false;">
                <div class="floating-search" style="margin-bottom: 0;">
                    <input type="text" id="dynamic-search" name="search" value="{{ search }}" placeholder="Rechercher des contrats...">
                    <button type="button" style="background: none; border: none; cursor: pointer;">🔍</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Bar -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 40px;">
        <div class="glass-card" style="margin-bottom: 0; padding: 20px 30px; display: flex; align-items: center; gap: 20px;">
            <div style="width: 60px; height: 60px; background: rgba(108, 92, 231, 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 24px;">📄</div>
            <div>
                <span class="kinetic-label-small" style="letter-spacing: 2px;">Contrats Actifs</span>
                <span style="font-size: 28px; font-weight: 900; color: #1a1a1a;">{{ activeCount }}</span>
            </div>
        </div>
        <div class="glass-card" style="margin-bottom: 0; padding: 20px 30px; display: flex; align-items: center; gap: 20px;">
            <div style="width: 60px; height: 60px; background: rgba(0, 210, 255, 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 24px;">💰</div>
            <div>
                <span class="kinetic-label-small" style="letter-spacing: 2px; color: #00d2ff;">Budget Total</span>
                <span style="font-size: 28px; font-weight: 900; color: #1a1a1a;">{{ totalPendingAmount }} <small style="font-size: 14px; color: #6b7280;">TND</small></span>
            </div>
        </div>
    </div>

    <div class="flex-between" style="margin-bottom: 24px;">
        <span style="color: #6b7280; font-weight: 500;">{{ contrats.getTotalItemCount }} contrats trouvés</span>
        <a href="{{ path('app_contrat_new') }}" class="button-primary">+ Nouveau Contrat</a>
    </div>

    <div class="bento-grid-container">
        {% for contrat in contrats %}
            {% set clientName = participantNames[contrat.clientId] ?? 'Client' %}
            <div class="glass-card">
                <div class="flex-between" style="margin-bottom: 15px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 48px; height: 48px; border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(5px); box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
                            <img src="{{ brand_logo(clientName) }}" alt="Logo" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                        </div>
                        <span class="squishy-badge {{ contrat.statut == 'PAYE' ? 'success' : 'warning' }}">
                            {{ contrat.statut }}
                        </span>
                    </div>
                    <span style="font-size: 13px; color: #9ca3af; font-weight: 600;">#{{ contrat.id }}</span>
                </div>
                
                <h2 class="bento-card-title">{{ contrat.titre }}</h2>
                <div class="kinetic-label-small">
                    CLIENT: {{ participantNames[contrat.clientId] ?? ('#' ~ contrat.clientId) }} | FREELANCER: {{ participantNames[contrat.freelancerId] ?? ('#' ~ contrat.freelancerId) }}
                </div>
                
                <p class="bento-card-desc">
                    {{ contrat.description|slice(0, 80) }}{{ contrat.description|length > 80 ? '...' : '' }}
                </p>
                
                <div style="margin-bottom: 20px;">
                    <span style="font-size: 13px; color: #6b7280;">Date: {{ contrat.dateContrat ? contrat.dateContrat|date('d/m/Y') : '' }}</span>
                </div>
                
                <div class="flex-between" style="align-items: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div class="currency-hover-wrapper" style="position: relative; cursor: help;">
                            <span class="cyber-price">{{ contrat.prix }} TND <span style="font-size: 14px; color: #a1a1aa; vertical-align: middle;">ⓘ</span></span>
                            
                            <!-- The tooltip box (hidden by default via CSS in <style> block later or inline JS below) -->
                            <div class="currency-tooltip" style="position: absolute; bottom: 100%; left: 0; margin-bottom: 8px; background: #1a1a1a; padding: 8px; border-radius: 8px; display: flex; flex-direction: column; gap: 6px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); opacity: 0; visibility: hidden; transform: translateY(5px); transition: all 0.2s; z-index: 50; white-space: nowrap;">
                                <span style="color: #fff; font-size: 12px; font-weight: 700;">🇪🇺 {{ contrat.prix|convert_currency('TND', 'EUR') }} EUR</span>
                                <span style="color: #fff; font-size: 12px; font-weight: 700;">🇺🇸 {{ contrat.prix|convert_currency('TND', 'USD') }} USD</span>
                                <!-- small triangle pointer -->
                                <div style="position: absolute; top: 100%; left: 20px; border-width: 5px; border-style: solid; border-color: #1a1a1a transparent transparent transparent;"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div style="display: flex; gap: 8px;">
                        <a href="{{ path('app_contrat_edit', {'id': contrat.id}) }}" class="button-primary" style="height: 35px; padding: 0 15px; font-size: 13px;">✏️ Editer</a>
                        {% if contrat.statut != 'PAYE' %}
                            <a href="{{ path('app_contrat_pay', {'id': contrat.id}) }}" class="button-primary" data-turbo="false" style="height: 35px; padding: 0 15px; font-size: 13px; background-color: #10b981;">💳 Payer</a>
                        {% endif %}
                        <a href="{{ path('app_contrat_export_pdf', {'id': contrat.id}) }}" target="_blank" class="button-primary" style="height: 35px; padding: 0 15px; font-size: 13px; background-color: #3b82f6;">📄 PDF</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="glass-card" style="grid-column: 1 / -1; text-align: center; padding: 50px;">
                <p style="color: #9ca3af; font-size: 18px;">Aucun contrat trouvé.</p>
            </div>
        {% endfor %}
    </div>

    {# KnpPaginator navigation — only renders if there is more than 1 page #}
    <div class="knp-pagination-wrapper">
        {{ knp_pagination_render(contrats) }}
    </div>
</div>

<style>
    .currency-hover-wrapper:hover .currency-tooltip {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateY(0) !important;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('dynamic-search');
    const cards = document.querySelectorAll('.bento-grid-container > .glass-card');
    const resultCount = document.querySelector('.flex-between span');

    searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach(card => {
            const text = card.textContent.toLowerCase();
            if (text.includes(query)) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        if (resultCount) {
            resultCount.textContent = `${visibleCount} contrat${visibleCount !== 1 ? 's' : ''} trouvé${visibleCount !== 1 ? 's' : ''}`;
        }
    });
});
</script>
{% endblock %}
