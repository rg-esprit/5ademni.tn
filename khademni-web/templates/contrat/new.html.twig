{% extends 'base.html.twig' %}

{% block title %}Nouveau Contrat{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/contrat_web.css') }}">
{% endblock %}

{% block body %}
{% include 'partials/_header.html.twig' %}
<div class="bento-root" style="max-width: 800px; margin: 0 auto;">
    <div class="top-bar">
        <div>
            <span class="kinetic-label-small">SaaS 2026 // CREATION</span>
            <h1 class="bento-title">Nouveau Contrat</h1>
        </div>
    </div>

    {% if not is_admin %}
        <div class="glass-card" style="margin-bottom: 20px; padding: 18px 22px;">
            {% if available_job_count > 0 %}
                <p style="margin: 0; color: #4b5563; font-weight: 500;">
                    Selectionnez une offre que vous possedez ou pour laquelle vous etes le freelancer accepte. Le formulaire se recharge automatiquement pour pre-remplir le contrat.
                </p>
            {% else %}
                <p style="margin: 0; color: #b45309; font-weight: 600;">
                    Vous devez d'abord avoir une offre avec un freelancer accepte, ou etre accepte sur une offre, pour creer un contrat.
                </p>
            {% endif %}
        </div>
    {% endif %}
    
    <div class="glass-card">
        {{ include('contrat/_form.html.twig') }}
    </div>
    
    <div style="margin-top: 20px;">
        <a href="{{ path('app_contrat_index') }}" style="color: #6c5ce7; text-decoration: none; font-weight: 600;">← Retour à la liste</a>
    </div>
</div>

{% if not is_admin and available_job_count > 0 %}
    <script>
        (() => {
            const jobSelector = document.querySelector('[data-contract-job-selector="1"]');
            if (!jobSelector) {
                return;
            }

            jobSelector.addEventListener('change', () => {
                const url = new URL(window.location.href);

                if (jobSelector.value) {
                    url.searchParams.set('jobId', jobSelector.value);
                } else {
                    url.searchParams.delete('jobId');
                }

                if (url.toString() !== window.location.href) {
                    window.location.assign(url.toString());
                }
            });
        })();
    </script>
{% endif %}
{% endblock %}
