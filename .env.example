# ==============================================================================
# 5ademni.tn Environment Variables Example
# Copy this file to .env (or .env.local for Symfony) and fill in your credentials.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Symfony Web Application (khademni-web)
# ------------------------------------------------------------------------------
APP_ENV=dev
APP_SECRET=change_this_to_a_unique_secret_string

# Database connection
DATABASE_URL="mysql://root:@127.0.0.1:3306/appdb?serverVersion=8.0.45&charset=utf8mb4"

# External microservices
FACE_BACKEND_URL="http://127.0.0.1:5003"
ELASTICSEARCH_URL="http://127.0.0.1:9200"

# AI Services for Web
OPENROUTER_API_KEY=""
OPENROUTER_URL="https://openrouter.ai/api/v1/chat/completions"
GROQ_API_KEY=""
GROQ_URL="https://api.groq.com/openai/v1/chat/completions"
GEMINI_API_KEY=""
HUGGINGFACE_API_KEY=""
SAFEPROMPT_API_KEY=""
SAFEPROMPT_URL="https://api.safeprompt.dev/api/v1/validate"

# Payment (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Messenger & Queue
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"

# Mailer
# Examples:
# MAILER_DSN=gmail://user@gmail.com:app-password@default
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@khademni.tn

# Google Calendar Integration
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Mercure (Real-time events)
MERCURE_DSN=mercure://default
MERCURE_URL=http://localhost:9090/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:9090/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"

# Storage & Third-Party APIs
VERCEL_BLOB_READ_WRITE_TOKEN=""
API_NINJAS_KEY=""

# ------------------------------------------------------------------------------
# 2. Java Desktop Application (khademni)
# (Can be configured via env vars or khademni/src/main/resources/config.properties)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
# DEEPSEEK_API_KEY=""
# HUGGINGFACE_API_KEY=""
# EXCHANGERATE_API_KEY=""
# VERCEL_BLOB_READ_WRITE_TOKEN=""
# STRIPE_SECRET_KEY=""

# Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Java Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. Python Face Recognition Service (face_backend)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appdb
DB_USER=root
DB_PASS=
